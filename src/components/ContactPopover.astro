---
interface Props {
  id: string;
  className?: string;
  requestHref?: string;
}

const {
  id,
  className = "",
  requestHref = "/yhteystiedot/#contact-heading",
} = Astro.props;

const titleId = `${id}-title`;
---

<div
  class:list={["process-contact-popover", className]}
  id={id}
  role="region"
  aria-labelledby={titleId}
  data-lvi-work-contact-popover
  hidden
>
  <div class="process-contact-popover__header">
    <p class="process-contact-popover__title" id={titleId}>Yhteystietomme</p>
    <button
      type="button"
      class="process-contact-popover__close"
      data-lvi-work-contact-close
      aria-label="Sulje yhteystiedot"
    >×</button>
  </div>
  <p class="process-contact-popover__label">Puhelin</p>
  <div class="process-contact-popover__phones">
    <a href="tel:+358469214415">Matias Ryynänen <span>046 921 4415</span></a>
    <a href="tel:+358504796544">Miro Sorjonen <span>050 479 6544</span></a>
  </div>
  <a class="process-contact-popover__action" href="mailto:matias.ryynanen@lviloisto.fi">Lähetä sähköpostia</a>
  <a class="process-contact-popover__action" href={requestHref}>Jätä yhteydenottopyyntö</a>
</div>
