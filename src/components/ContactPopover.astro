---
import EmailContactOptions from "./EmailContactOptions.astro";
import ContactPhones from "./ContactPhones.astro";

interface Props {
  id: string;
  className?: string;
  requestHref?: string;
  context?: "lvi-work" | "about";
}

const {
  id,
  className = "",
  requestHref = "/yhteystiedot/#contact-heading",
  context = "lvi-work",
} = Astro.props;

const titleId = `${id}-title`;
---

<div
  class:list={["process-contact-popover", className]}
  id={id}
  role="region"
  aria-labelledby={titleId}
  data-lvi-work-contact-popover={context === "lvi-work" ? "" : undefined}
  hidden
>
  <div class="process-contact-popover__header">
    <p class="process-contact-popover__title" id={titleId}>Yhteystietomme</p>
    <button
      type="button"
      class="process-contact-popover__close"
      data-lvi-work-contact-close
      aria-label="Sulje yhteystiedot"
    >×</button>
  </div>
  <p class="process-contact-popover__label">Puhelin</p>
  <ContactPhones />
  <EmailContactOptions />
  <a class="process-contact-popover__action" href={requestHref}>Jätä yhteydenottopyyntö</a>
</div>
