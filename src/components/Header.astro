<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="LVI-Loisto Oy etusivulle">
      <img src="/lvi-loisto-logo.svg" alt="LVI-Loisto Oy" class="brand__logo" />
    </a>
    <nav class="site-nav" aria-label="Päänavigaatio">
      <a href="/lvi-urakointi/">LVI-Työt</a>
      <a href="/yhteystiedot/">Yhteystiedot</a>
      <a href="/tietoa-meista/">Tietoa palveluistamme</a>
    </nav>
  </div>
</header>

<script>
  const initHeaderTheme = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const darkHero = document.querySelector<HTMLElement>(".home-hero, .service-page-hero");

    if (!header || !darkHero) return;

    let frame = 0;

    const updateHeaderTheme = () => {
      const headerBounds = header.getBoundingClientRect();
      const heroBounds = darkHero.getBoundingClientRect();
      const overlapsHero = heroBounds.top < headerBounds.bottom && heroBounds.bottom > headerBounds.bottom;

      header.classList.toggle("site-header--over-dark", overlapsHero);
      frame = 0;
    };

    const requestThemeUpdate = () => {
      if (!frame) {
        frame = window.requestAnimationFrame(updateHeaderTheme);
      }
    };

    updateHeaderTheme();
    window.addEventListener("scroll", requestThemeUpdate, { passive: true });
    window.addEventListener("resize", requestThemeUpdate);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderTheme, { once: true });
  } else {
    initHeaderTheme();
  }
</script>
