---
interface Props {
  initialTheme?: "dark" | "light";
}

const { initialTheme } = Astro.props;
const currentPath = Astro.url.pathname;
const navigation = [
  { href: "/tietoa-meista/", label: "Palvelumme", active: ["/tietoa-meista/", "/lvi-tyot/", "/lvi-urakointi/"].includes(currentPath) },
  { href: "/yrityksemme/", label: "Yrityksemme", active: currentPath === "/yrityksemme/" },
  { href: "/yhteystiedot/", label: "Yhteystiedot", active: currentPath === "/yhteystiedot/" },
];
---

<header class:list={["site-header", {
  "site-header--over-hero": Boolean(initialTheme),
  "site-header--over-dark": initialTheme === "dark",
}]}>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="LVI-Loisto Oy etusivulle">
      <img src="/lvi-loisto-logo.svg" alt="LVI-Loisto Oy" class="brand__logo" width="176" height="25" />
    </a>
    <button class="site-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Valikko</button>
    <nav class="site-nav" id="site-navigation" aria-label="Päänavigaatio">
      {navigation.map((item) => <a href={item.href} aria-current={item.active && currentPath === item.href ? "page" : undefined} class:list={{ "is-current": item.active }}>{item.label}</a>)}
      <div class="site-nav__services">
        <a href="/lvi-tyot/" aria-current={currentPath === "/lvi-tyot/" ? "page" : undefined}>LVI-työt</a>
        <a href="/lvi-urakointi/" aria-current={currentPath === "/lvi-urakointi/" ? "page" : undefined}>LVI-urakointi</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const initHeaderTheme = () => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const hero = document.querySelector<HTMLElement>(
      ".home-hero, .service-page-hero, .company-intro, .contact-details-section--hero",
    );

    if (!header) return;

    const toggle = header.querySelector<HTMLButtonElement>(".site-menu-toggle");
    const nav = header.querySelector<HTMLElement>(".site-nav");
    const mobile = window.matchMedia("(max-width: 760px)");
    const setMenuOpen = (open: boolean, returnFocus = false) => {
      header.classList.toggle("site-header--menu-open", open);
      toggle?.setAttribute("aria-expanded", String(open));
      if (toggle) toggle.textContent = open ? "Sulje" : "Valikko";
      if (nav) nav.inert = mobile.matches && !open;
      if (returnFocus) toggle?.focus();
    };
    setMenuOpen(false);
    toggle?.addEventListener("click", () => setMenuOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
    mobile.addEventListener("change", () => setMenuOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") setMenuOpen(false, true);
    });
    document.addEventListener("pointerdown", (event) => {
      if (!header.contains(event.target as Node)) setMenuOpen(false);
    });

    if (!hero) return;

    const isDarkHero = hero.matches(".home-hero, .service-page-hero, .company-intro--image, .contact-details-section--hero");

    let frame = 0;

    const updateHeaderTheme = () => {
      const headerBounds = header.getBoundingClientRect();
      const heroBounds = hero.getBoundingClientRect();
      const overlapsHero = heroBounds.top < headerBounds.bottom && heroBounds.bottom > headerBounds.bottom;

      header.classList.toggle("site-header--over-hero", overlapsHero);
      header.classList.toggle("site-header--over-dark", overlapsHero && isDarkHero);
      frame = 0;
    };

    const requestThemeUpdate = () => {
      if (!frame) {
        frame = window.requestAnimationFrame(updateHeaderTheme);
      }
    };

    updateHeaderTheme();
    window.addEventListener("scroll", requestThemeUpdate, { passive: true });
    window.addEventListener("resize", requestThemeUpdate);
    window.addEventListener("pageshow", updateHeaderTheme);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderTheme, { once: true });
  } else {
    initHeaderTheme();
  }
</script>
