---
import { micromark } from "micromark";
interface Props {
  items: { title: string; body: string[] }[];
}
const { items } = Astro.props;
---

<div class="service-accordion">
  {items.map((item, index) => (
    <details class="service-accordion__item">
      <summary>
        <h3>
          <span class="service-accordion__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <span>{item.title}</span>
          <span class="service-accordion__indicator" aria-hidden="true"></span>
        </h3>
      </summary>
      <div class="service-accordion__body">
        {item.body.map((paragraph) => <Fragment set:html={micromark(paragraph)} />)}
      </div>
    </details>
  ))}
</div>
