---
import section from "../content/cms/about-overview.json";
import ContactPopover from "./ContactPopover.astro";

interface Props {
  id?: string;
  requestHref?: string;
}

const { id, requestHref = "/yhteystiedot/#contact-heading" } = Astro.props;
const headingId = id ? `${id}-heading` : "about-overview-heading";

---

<section class="about-section" id={id} aria-labelledby={headingId}>
  <div class="about-section__inner">
    <div class="about-section__copy">
      <p class="section-label">{section.label}</p>
      <h2 id={headingId}>{section.title}</h2>

      <div class="about-section__body">
        {section.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="about-highlights" aria-label="LVI-Loiston osaamisen painopisteet">
        {
          section.highlights.map((highlight) => (
            <article class="about-highlight">
              <h3>{highlight.title}</h3>
              <p>{highlight.text}</p>
            </article>
          ))
        }
      </div>

      <div class="about-contact" data-about-contact>
        <button
          class="text-link about-contact__trigger"
          type="button"
          aria-controls="about-overview-contact-popover"
          aria-expanded="false"
          data-about-contact-trigger
        >{section.cta}</button>
        <ContactPopover
          id="about-overview-contact-popover"
          className="about-contact__popover"
          requestHref={requestHref}
          context="about"
        />
      </div>

      <div class="about-trust" aria-label="Luottamustunnukset">
        {
          section.trustMarks.map((mark) => (
            <img src={mark.src} alt={mark.alt} width={mark.width} height={mark.height} />
          ))
        }
      </div>
    </div>

    <figure class="about-carousel" data-about-carousel>
      <div class="about-carousel__viewport">
        {
          section.images.map((image, index) => (
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class={`about-carousel__image${index === 0 ? " is-active" : ""}`}
              data-carousel-image
              aria-hidden={index === 0 ? "false" : "true"}
            />
          ))
        }

        <div class="about-carousel__controls" aria-label="Kuvagallerian hallinta">
          <button type="button" class="about-carousel__button" data-carousel-prev aria-label="Näytä edellinen kuva">
            <span aria-hidden="true">←</span>
          </button>
          <span class="about-carousel__counter" data-carousel-counter>1 / {section.images.length}</span>
          <button type="button" class="about-carousel__button" data-carousel-next aria-label="Näytä seuraava kuva">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
      <figcaption class="about-carousel__caption">{section.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  const initAboutCarousels = () => {
    const carousels = Array.from(document.querySelectorAll("[data-about-carousel]"));

    carousels.forEach((carousel) => {
      const images = Array.from(carousel.querySelectorAll("[data-carousel-image]"));
      const previousButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const nextButton = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const counter = carousel.querySelector<HTMLElement>("[data-carousel-counter]");

      if (!images.length || !previousButton || !nextButton || !counter || carousel.hasAttribute("data-carousel-ready")) {
        return;
      }

      carousel.setAttribute("data-carousel-ready", "true");
      let activeIndex = 0;

      const showImage = (nextIndex: number) => {
        activeIndex = (nextIndex + images.length) % images.length;

        images.forEach((image, index) => {
          const isActive = index === activeIndex;
          image.classList.toggle("is-active", isActive);
          image.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        counter.textContent = `${activeIndex + 1} / ${images.length}`;
      };

      previousButton.addEventListener("click", () => showImage(activeIndex - 1));
      nextButton.addEventListener("click", () => showImage(activeIndex + 1));
      showImage(0);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutCarousels, { once: true });
  } else {
    initAboutCarousels();
  }
</script>
