---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import content from "../content/cms/home.json";

const title = content.seo.title;
const description = content.seo.description;
const solutionsSection = { ...content.hero, items: content.services.items };

const solutionIds = ["arvoasunnot", "omakotitalot", "taloyhtiot", "rakennusliikkeet"];
const sectionNavigation = solutionsSection.items.slice(0, solutionIds.length).map((item, index) => ({
  label: item.title,
  href: `#${solutionIds[index]}`,
}));

const portfolioSection = content.portfolio;

const processSection = content.process;

const faqSection = content.faq;

const contactSection = content.contact;
---

<BaseLayout title={title} description={description}>
  <section class="home-hero" aria-labelledby="home-heading">
    <figure class="home-hero__media">
      <img
        src={content.hero.image}
        alt={content.hero.imageAlt}
        fetchpriority="high"
      />
    </figure>

    <div class="home-hero__content page-shell">
      <div class="home-hero__primary">
        <h1 id="home-heading">
          {
            solutionsSection.titleLines.map((line, index) => (
              <>
                <span class="home-hero__title-line">{line}</span>
                {index < solutionsSection.titleLines.length - 1 ? " " : ""}
              </>
            ))
          }
        </h1>
        <p class="home-hero__intro">{solutionsSection.intro}</p>
        <div class="home-hero__contact">
          <button
            class="home-hero__cta"
            type="button"
            aria-controls="home-hero-contact-popover"
            aria-expanded="false"
            data-home-contact-trigger
          >{solutionsSection.cta}</button>
          <div
            class="process-contact-popover home-hero-contact-popover"
            id="home-hero-contact-popover"
            role="region"
            aria-labelledby="home-hero-contact-title"
            data-home-contact-popover
            hidden
          >
            <div class="process-contact-popover__header">
              <p class="process-contact-popover__title" id="home-hero-contact-title">Yhteystietomme</p>
              <button
                type="button"
                class="process-contact-popover__close"
                data-home-contact-close
                aria-label="Sulje yhteystiedot"
              >×</button>
            </div>
            <p class="process-contact-popover__label">Puhelin</p>
            <div class="process-contact-popover__phones">
              <a href="tel:+358469214415">Matias Ryynänen <span>046 921 4415</span></a>
              <a href="tel:+358504796544">Miro Sorjonen <span>050 479 6544</span></a>
            </div>
            <a class="process-contact-popover__action" href="mailto:matias.ryynanen@lviloisto.fi">Lähetä sähköpostia</a>
            <a class="process-contact-popover__action" href="#yhteystiedot">Jätä yhteydenottopyyntö</a>
          </div>
        </div>
        <nav class="section-anchor-nav section-anchor-nav--hero" aria-label="LVI-ratkaisut">
          {
            sectionNavigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>
      </div>
    </div>
  </section>

  <script>
    const initHomeContactPopover = () => {
      const trigger = document.querySelector("[data-home-contact-trigger]");
      const popover = document.querySelector("[data-home-contact-popover]");
      const closeButton = popover?.querySelector("[data-home-contact-close]");

      if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

      const setOpen = (isOpen, returnFocus = false) => {
        popover.hidden = !isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener("click", () => setOpen(popover.hidden));
      closeButton?.addEventListener("click", () => setOpen(false, true));
      popover.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("pointerdown", (event) => {
        if (!popover.hidden && !popover.parentElement?.contains(event.target as Node)) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !popover.hidden) setOpen(false, true);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHomeContactPopover, { once: true });
    } else {
      initHomeContactPopover();
    }
  </script>

  <section class="solutions-section" id="lvi-tyot" aria-labelledby="lvi-ratkaisut-heading">
    <h2 class="solutions-section__heading" id="lvi-ratkaisut-heading">LVI-ratkaisut</h2>
    <div class="solution-feature-list" aria-label="LVI-Loiston palvelupilarit">
      {
        solutionsSection.items.map((item, index) => (
          <article class="solution-feature page-shell" id={solutionIds[index]}>
            <figure
              class="solution-feature__media"
              data-scroll-image
              data-reveal-direction={index % 2 === 0 ? "left" : "right"}
            >
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
            </figure>
            <div class="solution-feature__copy">
              <h3>{item.title}</h3>
              {
                item.text.trim().split(/\r?\n\s*\r?\n/).map((paragraph) => (
                  <p>{paragraph.trim()}</p>
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    const revealImages = () => {
      const images = Array.from(document.querySelectorAll("[data-scroll-image]"));

      if (!images.length) {
        return;
      }

      document.documentElement.classList.add("scroll-reveal-ready");

      const reveal = (element) => {
        element.classList.add("is-visible");
      };

      if (!("IntersectionObserver" in window)) {
        images.forEach(reveal);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            reveal(entry.target);
            observer.unobserve(entry.target);
          });
        },
        {
          rootMargin: "0px 0px -12% 0px",
          threshold: 0.18,
        },
      );

      images.forEach((image) => observer.observe(image));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", revealImages, { once: true });
    } else {
      revealImages();
    }
  </script>

  <section class="process-section" id="menetelma" data-process-section>
    <div class="process-section__inner page-shell">
      <div class="process-section__header">
        <h2>{processSection.title}</h2>
        <p>{processSection.intro}</p>
      </div>

      <figure class="process-visual" aria-live="polite">
        <div class="process-visual__viewport">
          {
            processSection.steps.map((step, index) => (
              <img
                src={step.image}
                alt={step.imageAlt}
                loading="lazy"
                class={`process-visual__image${index === 0 ? " is-active" : ""}`}
                data-process-image
                aria-hidden={index === 0 ? "false" : "true"}
              />
            ))
          }
        </div>
        <figcaption class="process-visual__caption" data-process-caption>
          {processSection.steps[0].caption}
        </figcaption>
      </figure>

      <div class="process-section__steps">
        <div class="process-step-list" aria-label="Vaativan LVI-projektin eteneminen">
          {
            processSection.steps.map((step, index) => (
              <div class="process-step-entry">
                <button
                  type="button"
                  class={`process-step${index === 0 ? " is-active" : ""}`}
                  data-process-step
                  data-caption={step.caption}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-controls={index === 0 ? "process-contact-popover" : undefined}
                  aria-expanded={index === 0 ? "false" : undefined}
                >
                  <span class="process-step__number">{step.number}</span>
                  <span class="process-step__content">
                    <span class="process-step__title">{step.title}</span>
                    <span class="process-step__text">{step.text}</span>
                  </span>
                </button>
                {index === 0 && (
                  <div
                    class="process-contact-popover"
                    id="process-contact-popover"
                    role="region"
                    aria-labelledby="process-contact-title"
                    data-process-contact
                    hidden
                  >
                    <div class="process-contact-popover__header">
                      <p class="process-contact-popover__title" id="process-contact-title">Yhteystietomme</p>
                      <button
                        type="button"
                        class="process-contact-popover__close"
                        data-process-contact-close
                        aria-label="Sulje yhteystiedot"
                      >×</button>
                    </div>
                    <p class="process-contact-popover__label">Puhelin</p>
                    <div class="process-contact-popover__phones">
                      <a href="tel:+358469214415">Matias Ryynänen <span>046 921 4415</span></a>
                      <a href="tel:+358504796544">Miro Sorjonen <span>050 479 6544</span></a>
                    </div>
                    <a class="process-contact-popover__action" href="mailto:matias.ryynanen@lviloisto.fi">Lähetä sähköpostia</a>
                    <a class="process-contact-popover__action" href="#yhteystiedot">Jätä yhteydenottopyyntö</a>
                  </div>
                )}
              </div>
            ))
          }
        </div>

        <a class="process-section__cta text-link" href={processSection.ctaHref}>{processSection.cta}</a>
      </div>
    </div>
  </section>

  <section class="portfolio-section" id="kohteet">
    <div class="portfolio-section__inner page-shell">
      <div class="portfolio-section__header">
        <h2>{portfolioSection.title}</h2>
        <div class="portfolio-section__intro">
          <p>{portfolioSection.intro}</p>
          <a class="portfolio-section__cta" href={portfolioSection.ctaHref}>
            <span aria-hidden="true">↗</span>
            {portfolioSection.cta}
          </a>
        </div>
      </div>

      <div class="portfolio-grid" aria-label="LVI-Loistolle sopivat kohdetyypit">
        {
          portfolioSection.items.map((item) => (
            <a class="portfolio-card" href={item.href} aria-label={`Tutustu kohteeseen ${item.title}`}>
              <figure class="portfolio-card__media">
                <img src={item.image} alt={item.imageAlt} loading="lazy" />
              </figure>

              <div class="portfolio-card__content">
                <p class="portfolio-card__location">{item.location}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="portfolio-card__link">
                  <span>Tutustu kohteeseen</span>
                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contact-section" id="yhteystiedot" aria-labelledby="contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img src={contactSection.image} alt={contactSection.imageAlt} loading="lazy" />
      </figure>

      <div class="contact-panel">
        <p class="section-label">{contactSection.label}</p>
        <h2 id="contact-heading">{contactSection.title}</h2>
        <p class="contact-panel__intro">{contactSection.intro}</p>

        <ContactForm submitLabel={contactSection.submitLabel} />
      </div>
    </div>
  </section>

  <section class="faq-section" aria-labelledby="faq-heading">
    <div class="faq-section__inner page-shell">
      <div class="faq-section__header">
        <h2 id="faq-heading">{faqSection.title}</h2>
        <p>{faqSection.intro}</p>
      </div>

      <div class="faq-list">
        {
          faqSection.items.map((item) => (
            <details class="faq-item">
              <summary>
                <span>{item.question}</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const initProcessSections = () => {
      const sections = Array.from(document.querySelectorAll("[data-process-section]"));

      sections.forEach((section) => {
        const steps = Array.from(section.querySelectorAll("[data-process-step]"));
        const images = Array.from(section.querySelectorAll("[data-process-image]"));
        const caption = section.querySelector("[data-process-caption]");
        const contact = section.querySelector("[data-process-contact]");
        const closeButton = section.querySelector("[data-process-contact-close]");

        if (!steps.length || !images.length || !caption) {
          return;
        }

        const setActiveStep = (activeIndex) => {
          steps.forEach((step, index) => {
            const isActive = index === activeIndex;
            step.classList.toggle("is-active", isActive);
            step.setAttribute("aria-pressed", isActive ? "true" : "false");
          });

          images.forEach((image, index) => {
            const isActive = index === activeIndex;
            image.classList.toggle("is-active", isActive);
            image.setAttribute("aria-hidden", isActive ? "false" : "true");
          });

          caption.textContent = steps[activeIndex].dataset.caption || "";
        };

        const setContactOpen = (isOpen, returnFocus = false) => {
          if (!contact) return;
          contact.hidden = !isOpen;
          steps[0].setAttribute("aria-expanded", isOpen ? "true" : "false");
          if (returnFocus) steps[0].focus();
        };

        steps.forEach((step, index) => {
          step.addEventListener("mouseenter", () => setActiveStep(index));
          step.addEventListener("focus", () => setActiveStep(index));
          step.addEventListener("click", () => {
            setActiveStep(index);
            setContactOpen(index === 0 && Boolean(contact?.hidden));
          });
        });

        closeButton?.addEventListener("click", () => setContactOpen(false, true));
        contact?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setContactOpen(false));
        });
        document.addEventListener("pointerdown", (event) => {
          if (contact && !contact.hidden && !contact.parentElement.contains(event.target)) {
            setContactOpen(false);
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && contact && !contact.hidden) {
            setContactOpen(false, true);
          }
        });

        setActiveStep(0);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initProcessSections, { once: true });
    } else {
      initProcessSections();
    }
  </script>
</BaseLayout>
