---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "LVI-Loisto Oy | LVI-urakointia vaativiin kohteisiin";
const description =
  "LVI-Loisto toteuttaa laadukkaita LVI-ratkaisuja uudisrakennuksiin, saneerauksiin, arvoasuntoihin ja kiinteistöihin.";

const solutionsSection = {
  titleLines: ["LVI-ratkaisut", "vaativiin kohteisiin"],
  intro:
    "Toteutamme LVI-urakointia, saneerauksia ja lämmitysratkaisuja kohteisiin, joissa työnjäljellä, aikataululla ja huolellisella toteutuksella on erityinen merkitys.",
  items: [
    {
      number: "01",
      title: "Arvoasunnot ja saneerauskohteet",
      text: "Huolellista LVI-työtä valmiisiin ja vaativiin asuinympäristöihin.",
      image: "/images/home/arvoasunnot-saneeraus.jpeg",
      imageAlt: "Viimeistelty kylpyhuone saneerauskohteessa",
    },
    {
      number: "02",
      title: "Uudisrakennukset ja villat",
      text: "LVI-urakointia omakotitaloihin, huviloihin ja suuriin yksityiskohteisiin.",
      image: "/images/home/uudisrakennukset-villat.jpeg",
      imageAlt: "Laadukas kodinhoito- ja märkätila yksityiskohteessa",
    },
    {
      number: "03",
      title: "Taloyhtiöt ja kiinteistöt",
      text: "Lämmönjakokeskukset, kaukolämpökeskukset ja kiinteistöjen LVI-ratkaisut.",
      image: "/images/home/taloyhtiot-kiinteistot.jpg",
      imageAlt: "Tumma premium-tason sauna- ja märkätila",
    },
    {
      number: "04",
      title: "Lämmitysratkaisut",
      text: "Maalämpö, VILP ja lämmitysjärjestelmien uudistukset.",
      image: "/images/home/lammitysratkaisut.jpeg",
      imageAlt: "Tekninen lämmitysratkaisun ohjauslaite kodin tilassa",
    },
  ],
};

const qualitySection = {
  title: "Huolellinen toteutus näkyy vaativissa kohteissa",
  intro:
    "Arvoasunnoissa, saneerauskohteissa ja suurissa kiinteistöissä LVI-työn onnistuminen ei tarkoita vain teknistä toimivuutta. Toteutuksen pitää sopia kohteen aikatauluun, rakenteisiin, viimeistelyyn ja muuhun rakentamiseen.",
  image: "/images/home/quality-imgl1757.jpg",
  imageAlt: "Viimeistelty märkätilan allas ja kultaiset hanakalusteet",
  cta: "Keskustele kohteestasi",
  points: [
    {
      title: "Viimeistelty työnjälki",
      text: "LVI-ratkaisut toteutetaan niin, että lopputulos toimii teknisesti ja istuu kohteen viimeisteltyyn kokonaisuuteen.",
    },
    {
      title: "Yhteistyö suunnittelijoiden ja urakoitsijoiden kanssa",
      text: "Työt sovitetaan yhteen muun rakentamisen, aikataulun ja kohteen vaatimusten kanssa.",
    },
    {
      title: "Ratkaisut kohteen mukaan",
      text: "Jokainen kohde huomioidaan erikseen, oli kyseessä arvoasunto, taloyhtiö, huvila tai suurempi kiinteistö.",
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <section class="home-hero" aria-label="Etusivun pääkuva">
    <figure class="home-hero__media">
      <img
        src="/images/home/hero-imgl1743.jpg"
        alt="Tumma premium-tason märkätila kultaisilla suihkukalusteilla"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="solutions-section" id="lvi-tyot">
    <div class="solutions-section__header page-shell">
      <div>
        <h1>
          {
            solutionsSection.titleLines.map((line) => (
              <span class="solutions-section__title-line">{line}</span>
            ))
          }
        </h1>
      </div>
      <p class="solutions-section__intro">{solutionsSection.intro}</p>
    </div>

    <div class="solution-feature-list" aria-label="LVI-Loiston palvelupilarit">
      {
        solutionsSection.items.map((item) => (
          <article class="solution-feature page-shell">
            <figure class="solution-feature__media">
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
            </figure>
            <div class="solution-feature__copy">
              <span class="solution-feature__number">{item.number}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="quality-section" id="toteutus">
    <div class="quality-section__inner page-shell">
      <figure class="quality-section__media">
        <img src={qualitySection.image} alt={qualitySection.imageAlt} loading="lazy" />
      </figure>

      <div class="quality-section__copy">
        <h2>{qualitySection.title}</h2>
        <p class="quality-section__intro">{qualitySection.intro}</p>

        <div class="quality-list" aria-label="LVI-Loiston laatupilarit">
          {
            qualitySection.points.map((point) => (
              <article class="quality-list__item">
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </article>
            ))
          }
        </div>

        <a class="text-link" href="mailto:info@lviloisto.fi">{qualitySection.cta}</a>
      </div>
    </div>
  </section>
</BaseLayout>
