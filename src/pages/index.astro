      image: "/images/home/uudisrakennukset-villat.jpeg",
      imageAlt: "Laadukas kodinhoito- ja märkätila yksityiskohteessa",
    },
    {
      number: "03",
      title: "Taloyhtiöt ja kiinteistöt",
      text: "Lämmönjakokeskukset, kaukolämpökeskukset ja kiinteistöjen LVI-ratkaisut.",
      image: "/images/home/taloyhtiot-kiinteistot.jpg",
      imageAlt: "Tumma premium-tason sauna- ja märkätila",
    },
    {
      number: "04",
      title: "Lämmitysratkaisut",
      text: "Maalämpö, VILP ja lämmitysjärjestelmien uudistukset.",
      image: "/images/home/lammitysratkaisut.jpeg",
      imageAlt: "Tekninen lämmitysratkaisun ohjauslaite kodin tilassa",
