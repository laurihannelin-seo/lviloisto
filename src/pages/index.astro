  cta: "Aloita kohteen kartoitus",
  ctaHref: "mailto:info@lviloisto.fi",
  steps: [
    {
      number: "01",
      title: "Kartoitus",
      text: "Käymme läpi kohteen lähtötilanteen, tavoitteet, aikataulun ja tekniset tarpeet.",
      image: "/images/home/quality-imgl1757.jpg",
      imageAlt: "Kultaiset hanakalusteet ja viimeistelty kivipinta vaativassa märkätilassa",
      caption: "Lähtötilanteen, tavoitteiden ja teknisten tarpeiden ymmärtäminen.",
    },
    {
      number: "02",
      title: "Suunnittelu ja yhteensovitus",
      text: "Sovitamme LVI-ratkaisut kohteen rakenteisiin, suunnitelmiin ja muiden urakoitsijoiden työvaiheisiin.",
      image: "/images/home/uudisrakennukset-villat.jpeg",
      imageAlt: "Viimeistelty kodinhoito- ja märkätila yksityiskohteessa",
      caption: "LVI-ratkaisut sovitetaan kohteen rakenteisiin, suunnitelmiin ja aikatauluun.",
    },
    {
      number: "03",
      title: "Toteutus",
      text: "Työt tehdään sovitun aikataulun mukaan huolellisesti, siististi ja kohteen vaatimukset huomioiden.",
      image: "/images/home/taloyhtiot-kiinteistot.jpg",
      imageAlt: "Tumma premium-tason märkätila kultaisilla suihkukalusteilla",
      caption: "Huolellinen toteutus työmaalla kohteen vaatimukset huomioiden.",
    },
    {
      number: "04",
      title: "Viimeistely ja luovutus",
      text: "Lopputulos tarkistetaan, viimeistellään ja luovutetaan niin, että järjestelmät toimivat käytännössä.",
      image: "/images/home/arvoasunnot-saneeraus.jpeg",
      imageAlt: "Vaalea viimeistelty kylpyhuone arvoasunnon saneerauskohteessa",
      caption: "Lopputulos tarkistetaan, viimeistellään ja luovutetaan käyttöön.",
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <section class="home-hero" aria-label="Etusivun pääkuva">
    <figure class="home-hero__media">
      <img
        src="/images/home/hero-imgl1743.jpg"
        alt="Tumma premium-tason märkätila kultaisilla suihkukalusteilla"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="solutions-section" id="lvi-tyot">
    <div class="solutions-section__header page-shell">
      <figure class="solutions-section__header-media" data-scroll-image data-reveal-direction="left">
        <img src={solutionsSection.image} alt={solutionsSection.imageAlt} loading="lazy" />
      </figure>

      <div class="solutions-section__header-copy">
        <h1>
          {
            solutionsSection.titleLines.map((line) => (
              <span class="solutions-section__title-line">{line}</span>
            ))
          }
        </h1>
        <p class="solutions-section__intro">{solutionsSection.intro}</p>
      </div>
    </div>

    <div class="solution-feature-list" aria-label="LVI-Loiston palvelupilarit">
      {
        solutionsSection.items.map((item, index) => (
          <article class="solution-feature page-shell">
            <figure
              class="solution-feature__media"
              data-scroll-image
              data-reveal-direction={index % 2 === 0 ? "left" : "right"}
            >
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
            </figure>
            <div class="solution-feature__copy">
              <span class="solution-feature__number">{item.number}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    const revealImages = () => {
      const images = Array.from(document.querySelectorAll("[data-scroll-image]"));

      if (!images.length) {
        return;
      }

      document.documentElement.classList.add("scroll-reveal-ready");

      const reveal = (element) => {
        element.classList.add("is-visible");
      };

      if (!("IntersectionObserver" in window)) {
        images.forEach(reveal);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            reveal(entry.target);
            observer.unobserve(entry.target);
          });
        },
        {
          rootMargin: "0px 0px -12% 0px",
          threshold: 0.18,
        },
      );

      images.forEach((image) => observer.observe(image));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", revealImages, { once: true });
    } else {
      revealImages();
    }
  </script>

  <section class="about-section" id="tietoa-meista">
    <div class="about-section__inner">
      <div class="about-section__copy">
        <p class="section-label">{aboutSection.label}</p>
        <h2>{aboutSection.title}</h2>

        <div class="about-section__body">
          {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="about-highlights" aria-label="LVI-Loiston osaamisen painopisteet">
          {
            aboutSection.highlights.map((highlight) => (
              <article class="about-highlight">
                <h3>{highlight.title}</h3>
                <p>{highlight.text}</p>
              </article>
            ))
          }
        </div>

        <a class="text-link" href="mailto:info@lviloisto.fi">{aboutSection.cta}</a>
      </div>

      <figure class="about-carousel" data-about-carousel>
        <div class="about-carousel__viewport">
          {
            aboutSection.images.map((image, index) => (
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class={`about-carousel__image${index === 0 ? " is-active" : ""}`}
                data-carousel-image
                aria-hidden={index === 0 ? "false" : "true"}
              />
            ))
          }

          <div class="about-carousel__controls" aria-label="Kuvagallerian hallinta">
            <button type="button" class="about-carousel__button" data-carousel-prev aria-label="Näytä edellinen kuva">
              <span aria-hidden="true">←</span>
            </button>
            <span class="about-carousel__counter" data-carousel-counter>1 / {aboutSection.images.length}</span>
            <button type="button" class="about-carousel__button" data-carousel-next aria-label="Näytä seuraava kuva">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
        <figcaption class="about-carousel__caption">{aboutSection.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="process-section" id="menetelma" data-process-section>
    <div class="process-section__inner page-shell">
      <div class="process-section__header">
        <p class="section-label">{processSection.label}</p>
        <h2>{processSection.title}</h2>
        <p>{processSection.intro}</p>
      </div>

      <figure class="process-visual" aria-live="polite">
        <div class="process-visual__viewport">
          {
            processSection.steps.map((step, index) => (
              <img
                src={step.image}
                alt={step.imageAlt}
                loading="lazy"
                class={`process-visual__image${index === 0 ? " is-active" : ""}`}
                data-process-image
                aria-hidden={index === 0 ? "false" : "true"}
              />
            ))
          }
        </div>
        <figcaption class="process-visual__caption" data-process-caption>
          {processSection.steps[0].caption}
        </figcaption>
      </figure>

      <div class="process-section__steps">
        <div class="process-step-list" aria-label="Vaativan LVI-projektin eteneminen">
          {
            processSection.steps.map((step, index) => (
              <button
                type="button"
                class={`process-step${index === 0 ? " is-active" : ""}`}
                data-process-step
                data-caption={step.caption}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="process-step__number">{step.number}</span>
                <span class="process-step__content">
                  <span class="process-step__title">{step.title}</span>
                  <span class="process-step__text">{step.text}</span>
                </span>
              </button>
            ))
          }
        </div>

        <a class="process-section__cta text-link" href={processSection.ctaHref}>{processSection.cta}</a>
      </div>
    </div>
  </section>

  <section class="portfolio-section" id="kohteet">
    <div class="portfolio-section__inner page-shell">
      <div class="portfolio-section__header">
        <h2>{portfolioSection.title}</h2>
        <div class="portfolio-section__intro">
          <p>{portfolioSection.intro}</p>
          <a class="portfolio-section__cta" href={portfolioSection.ctaHref}>
            <span aria-hidden="true">↗</span>
            {portfolioSection.cta}
          </a>
        </div>
      </div>

      <div class="portfolio-grid" aria-label="LVI-Loistolle sopivat kohdetyypit">
        {
          portfolioSection.items.map((item) => (
            <a class="portfolio-card" href={item.href} aria-label={`Tutustu kohteeseen ${item.title}`}>
              <figure class="portfolio-card__media">
                <img src={item.image} alt={item.imageAlt} loading="lazy" />
              </figure>

              <div class="portfolio-card__content">
                <p class="portfolio-card__location">{item.location}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <span class="portfolio-card__link">
                  <span>Tutustu kohteeseen</span>
                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const initAboutCarousels = () => {
      const carousels = Array.from(document.querySelectorAll("[data-about-carousel]"));

      carousels.forEach((carousel) => {
        const images = Array.from(carousel.querySelectorAll("[data-carousel-image]"));
        const previousButton = carousel.querySelector("[data-carousel-prev]");
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const counter = carousel.querySelector("[data-carousel-counter]");

        if (!images.length || !previousButton || !nextButton || !counter) {
          return;
        }

        let activeIndex = 0;

        const showImage = (nextIndex) => {
          activeIndex = (nextIndex + images.length) % images.length;

          images.forEach((image, index) => {
            const isActive = index === activeIndex;
            image.classList.toggle("is-active", isActive);
            image.setAttribute("aria-hidden", isActive ? "false" : "true");
          });

          counter.textContent = `${activeIndex + 1} / ${images.length}`;
        };

        previousButton.addEventListener("click", () => showImage(activeIndex - 1));
        nextButton.addEventListener("click", () => showImage(activeIndex + 1));
        showImage(0);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAboutCarousels, { once: true });
    } else {
      initAboutCarousels();
    }
  </script>

  <script>
    const initProcessSections = () => {
      const sections = Array.from(document.querySelectorAll("[data-process-section]"));

      sections.forEach((section) => {
        const steps = Array.from(section.querySelectorAll("[data-process-step]"));
        const images = Array.from(section.querySelectorAll("[data-process-image]"));
        const caption = section.querySelector("[data-process-caption]");

        if (!steps.length || !images.length || !caption) {
          return;
        }

        const setActiveStep = (activeIndex) => {
          steps.forEach((step, index) => {
            const isActive = index === activeIndex;
            step.classList.toggle("is-active", isActive);
            step.setAttribute("aria-pressed", isActive ? "true" : "false");
          });

          images.forEach((image, index) => {
            const isActive = index === activeIndex;
            image.classList.toggle("is-active", isActive);
            image.setAttribute("aria-hidden", isActive ? "false" : "true");
          });

          caption.textContent = steps[activeIndex].dataset.caption || "";
        };

        steps.forEach((step, index) => {
          step.addEventListener("mouseenter", () => setActiveStep(index));
          step.addEventListener("focus", () => setActiveStep(index));
          step.addEventListener("click", () => setActiveStep(index));
        });

        setActiveStep(0);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initProcessSections, { once: true });
    } else {
      initProcessSections();
    }
  </script>
</BaseLayout>
