---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "LVI-Loisto Oy | LVI-urakointia vaativiin kohteisiin";
const description =
  "LVI-Loisto toteuttaa laadukkaita LVI-ratkaisuja uudisrakennuksiin, saneerauksiin, arvoasuntoihin ja kiinteistöihin.";

const solutionsSection = {
  titleLines: ["LVI-ratkaisut", "vaativiin kohteisiin"],
  intro:
    "Toteutamme LVI-urakointia, saneerauksia ja lämmitysratkaisuja kohteisiin, joissa työnjäljellä, aikataululla ja huolellisella toteutuksella on erityinen merkitys.",
  items: [
    {
      number: "01",
      title: "Arvoasunnot ja saneerauskohteet",
      text: "Huolellista LVI-työtä valmiisiin ja vaativiin asuinympäristöihin.",
      image: "/images/home/arvoasunnot-saneeraus.jpeg",
      imageAlt: "Viimeistelty kylpyhuone saneerauskohteessa",
    },
    {
      number: "02",
      title: "Uudisrakennukset ja villat",
      text: "LVI-urakointia omakotitaloihin, huviloihin ja suuriin yksityiskohteisiin.",
      image: "/images/home/uudisrakennukset-villat.jpeg",
      imageAlt: "Laadukas kodinhoito- ja märkätila yksityiskohteessa",
    },
    {
      number: "03",
      title: "Taloyhtiöt ja kiinteistöt",
      text: "Lämmönjakokeskukset, kaukolämpökeskukset ja kiinteistöjen LVI-ratkaisut.",
      image: "/images/home/taloyhtiot-kiinteistot.jpg",
      imageAlt: "Tumma premium-tason sauna- ja märkätila",
    },
    {
      number: "04",
      title: "Lämmitysratkaisut",
      text: "Maalämpö, VILP ja lämmitysjärjestelmien uudistukset.",
      image: "/images/home/lammitysratkaisut.jpeg",
      imageAlt: "Tekninen lämmitysratkaisun ohjauslaite kodin tilassa",
    },
  ],
};

const qualitySection = {
  title: "Huolellinen toteutus näkyy vaativissa kohteissa",
  intro:
    "Arvoasunnoissa, saneerauskohteissa ja suurissa kiinteistöissä LVI-työn onnistuminen ei tarkoita vain teknistä toimivuutta. Toteutuksen pitää sopia kohteen aikatauluun, rakenteisiin, viimeistelyyn ja muuhun rakentamiseen.",
  image: "/images/home/quality-imgl1757.jpg",
  imageAlt: "Viimeistelty märkätilan allas ja kultaiset hanakalusteet",
  cta: "Keskustele kohteestasi",
  points: [
    {
      title: "Viimeistelty työnjälki",
      text: "LVI-ratkaisut toteutetaan niin, että lopputulos toimii teknisesti ja istuu kohteen viimeisteltyyn kokonaisuuteen.",
    },
    {
      title: "Yhteistyö suunnittelijoiden ja urakoitsijoiden kanssa",
      text: "Työt sovitetaan yhteen muun rakentamisen, aikataulun ja kohteen vaatimusten kanssa.",
    },
    {
      title: "Ratkaisut kohteen mukaan",
      text: "Jokainen kohde huomioidaan erikseen, oli kyseessä arvoasunto, taloyhtiö, huvila tai suurempi kiinteistö.",
    },
  ],
};

const aboutSection = {
  label: "TIETOA MEISTÄ",
  title: "LVI-kumppani vaativiin koteihin ja kiinteistöihin",
  body: [
    "LVI-Loisto toteuttaa LVI-urakointia, saneerauksia ja lämmitysratkaisuja kohteisiin, joissa tekninen toimivuus, huolellinen työnjälki ja sujuva yhteistyö ratkaisevat lopputuloksen.",
    "Työskentelemme yksityisasiakkaiden, taloyhtiöiden, rakennusliikkeiden ja suunnittelijoiden kanssa kohteissa, joissa LVI-ratkaisujen pitää sopia sekä teknisiin vaatimuksiin että kohteen viimeisteltyyn kokonaisuuteen.",
  ],
  images: [
    {
      src: "/images/home/about-imgl1779.jpg",
      alt: "Vaalea viimeistelty kylpyhuone puisella katolla ja marmoripinnoilla",
    },
    {
      src: "/images/home/arvoasunnot-saneeraus.jpeg",
      alt: "Viimeistelty kylpyhuone arvoasunnon saneerauskohteessa",
    },
    {
      src: "/images/home/uudisrakennukset-villat.jpeg",
      alt: "Laadukas kodinhoito- ja märkätila yksityiskohteessa",
    },
    {
      src: "/images/home/quality-imgl1757.jpg",
      alt: "Kultaiset hanakalusteet viimeistellyssä märkätilassa",
    },
  ],
  caption:
    "Arvoasuntojen ja vaativien kohteiden LVI-ratkaisuissa korostuvat tekninen varmuus, siisti toteutus ja yksityiskohtien hallinta.",
  cta: "Keskustele kohteestasi",
  highlights: [
    {
      title: "Suunnitelmallinen toteutus",
      text: "Työ sovitetaan kohteen aikatauluun, rakenteisiin ja muiden urakoitsijoiden etenemiseen.",
    },
    {
      title: "Siisti ja viimeistelty työnjälki",
      text: "Erityisesti valmiissa asuinympäristöissä toteutuksen pitää olla huolellinen alusta loppuun.",
    },
    {
      title: "Teknisesti kestävä lopputulos",
      text: "Ratkaisut valitaan niin, että ne toimivat käytössä, eivät vain näytä hyvältä luovutushetkellä.",
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <section class="home-hero" aria-label="Etusivun pääkuva">
    <figure class="home-hero__media">
      <img
        src="/images/home/hero-imgl1743.jpg"
        alt="Tumma premium-tason märkätila kultaisilla suihkukalusteilla"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="solutions-section" id="lvi-tyot">
    <div class="solutions-section__header page-shell">
      <div>
        <h1>
          {
            solutionsSection.titleLines.map((line) => (
              <span class="solutions-section__title-line">{line}</span>
            ))
          }
        </h1>
      </div>
      <p class="solutions-section__intro">{solutionsSection.intro}</p>
    </div>

    <div class="solution-feature-list" aria-label="LVI-Loiston palvelupilarit">
      {
        solutionsSection.items.map((item, index) => (
          <article class="solution-feature page-shell">
            <figure
              class="solution-feature__media"
              data-scroll-image
              data-reveal-direction={index % 2 === 0 ? "left" : "right"}
            >
              <img src={item.image} alt={item.imageAlt} loading="lazy" />
            </figure>
            <div class="solution-feature__copy">
              <span class="solution-feature__number">{item.number}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    const revealImages = () => {
      const images = Array.from(document.querySelectorAll("[data-scroll-image]"));

      if (!images.length) {
        return;
      }

      document.documentElement.classList.add("scroll-reveal-ready");

      const reveal = (element) => {
        element.classList.add("is-visible");
      };

      if (!("IntersectionObserver" in window)) {
        images.forEach(reveal);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            reveal(entry.target);
            observer.unobserve(entry.target);
          });
        },
        {
          rootMargin: "0px 0px -12% 0px",
          threshold: 0.18,
        },
      );

      images.forEach((image) => observer.observe(image));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", revealImages, { once: true });
    } else {
      revealImages();
    }
  </script>

  <section class="quality-section" id="toteutus">
    <div class="quality-section__inner page-shell">
      <figure class="quality-section__media">
        <img src={qualitySection.image} alt={qualitySection.imageAlt} loading="lazy" />
      </figure>

      <div class="quality-section__copy">
        <h2>{qualitySection.title}</h2>
        <p class="quality-section__intro">{qualitySection.intro}</p>

        <div class="quality-list" aria-label="LVI-Loiston laatupilarit">
          {
            qualitySection.points.map((point) => (
              <article class="quality-list__item">
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </article>
            ))
          }
        </div>

        <a class="text-link" href="mailto:info@lviloisto.fi">{qualitySection.cta}</a>
      </div>
    </div>
  </section>

  <section class="about-section" id="tietoa-meista">
    <div class="about-section__inner">
      <div class="about-section__copy">
        <p class="section-label">{aboutSection.label}</p>
        <h2>{aboutSection.title}</h2>

        <div class="about-section__body">
          {aboutSection.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="about-highlights" aria-label="LVI-Loiston osaamisen painopisteet">
          {
            aboutSection.highlights.map((highlight) => (
              <article class="about-highlight">
                <h3>{highlight.title}</h3>
                <p>{highlight.text}</p>
              </article>
            ))
          }
        </div>

        <a class="text-link" href="mailto:info@lviloisto.fi">{aboutSection.cta}</a>
      </div>

      <figure class="about-carousel" data-about-carousel>
        <div class="about-carousel__viewport">
          {
            aboutSection.images.map((image, index) => (
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class={`about-carousel__image${index === 0 ? " is-active" : ""}`}
                data-carousel-image
                aria-hidden={index === 0 ? "false" : "true"}
              />
            ))
          }

          <div class="about-carousel__controls" aria-label="Kuvagallerian hallinta">
            <button type="button" class="about-carousel__button" data-carousel-prev aria-label="Näytä edellinen kuva">
              <span aria-hidden="true">←</span>
            </button>
            <span class="about-carousel__counter" data-carousel-counter>1 / {aboutSection.images.length}</span>
            <button type="button" class="about-carousel__button" data-carousel-next aria-label="Näytä seuraava kuva">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
        <figcaption class="about-carousel__caption">{aboutSection.caption}</figcaption>
      </figure>
    </div>
  </section>

  <script>
    const initAboutCarousels = () => {
      const carousels = Array.from(document.querySelectorAll("[data-about-carousel]"));

      carousels.forEach((carousel) => {
        const images = Array.from(carousel.querySelectorAll("[data-carousel-image]"));
        const previousButton = carousel.querySelector("[data-carousel-prev]");
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const counter = carousel.querySelector("[data-carousel-counter]");

        if (!images.length || !previousButton || !nextButton || !counter) {
          return;
        }

        let activeIndex = 0;

        const showImage = (nextIndex) => {
          activeIndex = (nextIndex + images.length) % images.length;

          images.forEach((image, index) => {
            const isActive = index === activeIndex;
            image.classList.toggle("is-active", isActive);
            image.setAttribute("aria-hidden", isActive ? "false" : "true");
          });

          counter.textContent = `${activeIndex + 1} / ${images.length}`;
        };

        previousButton.addEventListener("click", () => showImage(activeIndex - 1));
        nextButton.addEventListener("click", () => showImage(activeIndex + 1));
        showImage(0);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAboutCarousels, { once: true });
    } else {
      initAboutCarousels();
    }
  </script>
</BaseLayout>
