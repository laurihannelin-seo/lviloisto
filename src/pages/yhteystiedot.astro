---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import content from "../content/cms/yhteystiedot.json";

const title = content.seo.title;
const description = content.seo.description;
const contactPage = content.contact;
const mapSection = content.map;
const appleMapsUrl = new URL("https://maps.apple.com/search");
appleMapsUrl.searchParams.set("query", mapSection.address);
const details = content.detailsSection.groups;
const intro = content.detailsSection.intro;
const formLinkWord = "lomakkeen";
const formLinkIndex = intro.toLocaleLowerCase("fi").indexOf(formLinkWord);
---

<BaseLayout title={title} description={description} headerTheme="dark">
  <section class="contact-details-section contact-details-section--hero" aria-labelledby="page-heading">
    <img
      class="contact-details-section__image"
      src={content.detailsSection.image}
      alt={content.detailsSection.imageAlt}
      fetchpriority="high"
    />
    <div class="contact-details-section__shade" aria-hidden="true"></div>
    <div class="contact-details-section__inner page-shell">
      <div class="contact-details-section__header">
        <h1 id="page-heading">{content.detailsSection.title}</h1>
        <p>
          {formLinkIndex < 0 ? intro : (
            <>
              {intro.slice(0, formLinkIndex)}<a href="#contact-heading">{intro.slice(formLinkIndex, formLinkIndex + formLinkWord.length)}</a>{intro.slice(formLinkIndex + formLinkWord.length)}
            </>
          )}
        </p>
      </div>

      <div class="contact-details-grid">
        {
          details.map((group) => (
            <section class:list={["contact-detail", { "contact-detail--person": group.kind === "person" }]} aria-labelledby={`detail-${group.id}`}>
              <h2 id={`detail-${group.id}`}>{group.label}</h2>
              <div class="contact-detail__items">
                {
                  group.items.map((item) => (
                    item.href ? <a href={item.href}>{item.text}</a> : <p>{item.text}</p>
                  ))
                }
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="map-section" aria-labelledby="map-heading">
    <div class="map-section__inner page-shell">
      <div class="map-section__content">
        <h2 id="map-heading">{mapSection.title}</h2>
        <p>{mapSection.intro}</p>
        <div class="map-section__links">
          <a href={mapSection.mapsUrl}>{mapSection.address}</a>
          <a href={mapSection.mapsUrl}>{mapSection.linkLabel} <span aria-hidden="true">→</span></a>
          <a href={appleMapsUrl.toString()}>Avaa Apple Kartoissa <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="map-section__frame">
        <iframe
          src={mapSection.iframeSrc}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={mapSection.iframeTitle}
        ></iframe>
      </div>
    </div>
  </section>

  <section class="contact-section contact-section--page" aria-labelledby="contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img src={contactPage.image} alt={contactPage.imageAlt} loading="lazy" />
      </figure>

      <div class="contact-panel">
        <p class="section-label">{contactPage.label}</p>
        <h2 id="contact-heading">{contactPage.title}</h2>
        <p class="contact-panel__intro">{contactPage.intro}</p>

        <ContactForm submitLabel={contactPage.submitLabel} />
      </div>
    </div>
  </section>
</BaseLayout>
