---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const title = "Yhteystiedot | LVI-Loisto Oy";
const description =
  "Ota yhteyttä LVI-Loistoon. Pyydä tarjous vaativaan LVI-urakointiin, saneeraukseen, lämmitysratkaisuun tai kiinteistökohteen LVI-toteutukseen.";

const contactPage = {
  label: "YHTEYDENOTTO",
  title: "Pyydä tarjous",
  intro:
    "Kerro millaisesta kohteesta on kyse, missä se sijaitsee ja mitä LVI-kokonaisuutta tarvitset. Palaamme asiaan ja arvioimme, miten projekti kannattaa viedä eteenpäin.",
  image: "/images/home/contact-shower-cropped.jpg",
  imageAlt: "Kultainen sadesuihku viimeistellyssä tummassa märkätilassa",
  submitLabel: "Lähetä tarjouspyyntö",
};

const mapSection = {
  title: "Toimialueemme",
  intro: "Toimipisteemme sijaitsee Helsingissä osoitteessa Työpajankatu 13 A.",
  address: "Työpajankatu 13 A, 00580 Helsinki",
  mapsUrl:
    "https://www.google.com/maps/search/?api=1&query=Ty%C3%B6pajankatu+13+A%2C+00580+Helsinki",
  iframeSrc:
    "https://www.google.com/maps?q=Ty%C3%B6pajankatu%2013%20A%2C%2000580%20Helsinki&output=embed",
};

const contactDetailsIntro =
  "Voit olla meihin yhteydessä suoraan puhelimitse tai sähköpostilla. Tarjouspyynnöt ja projektitiedustelut voi lähettää myös lomakkeen kautta.";

const details = [
  {
    id: "yritys",
    label: "Yritys",
    items: [
      "LVI-Loisto Oy",
      "Työpajankatu 13 A",
      "00580 Helsinki",
      "Y-tunnus 3254898-6",
    ],
  },
  {
    id: "matias",
    label: "Matias Ryynänen",
    kind: "person",
    items: [
      { text: "046 921 4415", href: "tel:+358469214415" },
      { text: "matias.ryynanen@lviloisto.fi", href: "mailto:matias.ryynanen@lviloisto.fi" },
    ],
  },
  {
    id: "miro",
    label: "Miro Sorjonen",
    kind: "person",
    items: [
      { text: "050 479 6544", href: "tel:+358504796544" },
      { text: "miro.sorjonen@lviloisto.fi", href: "mailto:miro.sorjonen@lviloisto.fi" },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="contact-section contact-section--page" aria-labelledby="contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img src={contactPage.image} alt={contactPage.imageAlt} loading="eager" />
      </figure>

      <div class="contact-panel">
        <p class="section-label">{contactPage.label}</p>
        <h1 id="contact-heading">{contactPage.title}</h1>
        <p class="contact-panel__intro">{contactPage.intro}</p>

        <ContactForm submitLabel={contactPage.submitLabel} />
      </div>
    </div>
  </section>

  <section class="map-section" aria-labelledby="map-heading">
    <div class="map-section__inner page-shell">
      <div class="map-section__content">
        <h2 id="map-heading">{mapSection.title}</h2>
        <p>{mapSection.intro}</p>
        <div class="map-section__links">
          <a href={mapSection.mapsUrl}>{mapSection.address}</a>
          <a href={mapSection.mapsUrl}>Avaa Google Mapsissa <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="map-section__frame">
        <iframe
          src={mapSection.iframeSrc}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Google Maps -kartta LVI-Loiston toimipisteelle"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="contact-details-section" aria-labelledby="details-heading">
    <div class="contact-details-section__inner page-shell">
      <div class="contact-details-section__header">
        <h2 id="details-heading">Ota yhteyttä suoraan</h2>
        <p>{contactDetailsIntro}</p>
      </div>

      <div class="contact-details-grid">
        {
          details.map((group) => (
            <section class:list={["contact-detail", { "contact-detail--person": group.kind === "person" }]} aria-labelledby={`detail-${group.id}`}>
              <h3 id={`detail-${group.id}`}>{group.label}</h3>
              <div class="contact-detail__items">
                {
                  group.items.map((item) => (
                    typeof item === "string" ? (
                      <p>{item}</p>
                    ) : (
                      <a href={item.href}>{item.text}</a>
                    )
                  ))
                }
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
