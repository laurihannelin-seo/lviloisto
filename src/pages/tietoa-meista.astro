---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutOverviewSection from "../components/AboutOverviewSection.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import NumberedContentList from "../components/NumberedContentList.astro";
import ServiceContentSection from "../components/ServiceContentSection.astro";
import content from "../content/cms/tietoa-meista.json";

const title = content.seo.title;
const description = content.seo.description;
const pageHero = content.hero;
const positioning = content.positioning;
const audiences = content.audiencesSection.items;
const method = content.method;
const companyDetails = content.region.groups;
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero about-page-hero" aria-labelledby="about-page-heading">
    <img class="service-page-hero__image" src={pageHero.image} alt={pageHero.imageAlt} fetchpriority="high" />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs variant="dark" items={[{ label: "Etusivu", href: "/" }, { label: "Tietoa meistä" }]} />
      <div class="service-page-hero__copy">
        <h1 id="about-page-heading">{pageHero.title}</h1>
        <p>{pageHero.intro}</p>
      </div>
    </div>
  </section>

  <AboutOverviewSection ctaHref="/yhteystiedot/" />

  <div class="service-content-page">
    <ServiceContentSection id="osaamisemme" title={positioning.title}>
      <div class="about-positioning-layout">
        <div class="service-prose">
          {positioning.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <figure class="about-positioning-layout__media">
          <img src={positioning.image} alt={positioning.imageAlt} loading="lazy" />
        </figure>
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="kohteet" title={content.audiencesSection.title}>
      <div class="service-detail-grid">
        {
          audiences.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="tyoskentelytapa" title={method.title} intro={method.intro}>
      <NumberedContentList items={method.rows} columns={4} ariaLabel="Työskentelymme vaiheet" />
    </ServiceContentSection>

    <ServiceContentSection
      id="toimialue"
      title={content.region.title}
      intro={content.region.intro}
    >
      <div class="contact-details-grid about-company-details" aria-label="LVI-Loiston yritystiedot">
        {
          companyDetails.map((group) => (
            <section class:list={["contact-detail", { "contact-detail--person": group.kind === "person" }]}>
              <h3>{group.title}</h3>
              <div class="contact-detail__items">
                {
                  group.items.map((item) => (
                    item.href ? <a href={item.href}>{item.text}</a> : <p>{item.text}</p>
                  ))
                }
              </div>
            </section>
          ))
        }
      </div>
    </ServiceContentSection>
  </div>

  <section class="about-final-cta">
    <div class="about-final-cta__inner service-page-shell">
      <h2>{content.finalCta.title}</h2>
      <p>{content.finalCta.text}</p>
      <a href="/yhteystiedot/">{content.finalCta.linkLabel}</a>
    </div>
  </section>
</BaseLayout>
