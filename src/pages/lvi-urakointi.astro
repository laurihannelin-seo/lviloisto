---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailContactOptions from "../components/EmailContactOptions.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import FaqSection from "../components/FaqSection.astro";
import NumberedContentList from "../components/NumberedContentList.astro";
import ServiceContentSection from "../components/ServiceContentSection.astro";
import content from "../content/cms/lvi-urakointi.json";

const title = content.seo.title;
const description = content.seo.description;
const serviceItems = content.services.items;

const projectTypes = content.audiences.items;

const processSteps = content.process.items;

const trustItems = content.trust.items;

const portfolioItems = content.portfolio.items;

const cityPages = content.cities.items;

const faqItems = content.faq.items;
---

<BaseLayout title={title} description={description} headerTheme="dark">
  <section class="service-page-hero" aria-labelledby="service-page-heading">
    <img
      class="service-page-hero__image"
      src={content.hero.image}
      alt={content.hero.imageAlt}
      loading="eager"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-urakointi" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="service-page-heading">{content.hero.title}</h1>
        <p>{content.hero.intro}</p>
        <div class="service-page-hero__actions">
          <div class="service-page-hero__contact">
            <button
              class="service-page-hero__primary"
              type="button"
              aria-controls="service-hero-contact-popover"
              aria-expanded="false"
              data-service-contact-trigger
            >{content.hero.primaryCta}</button>
            <div
              class="process-contact-popover service-page-contact-popover"
              id="service-hero-contact-popover"
              role="region"
              aria-labelledby="service-hero-contact-title"
              data-service-contact-popover
              hidden
            >
              <div class="process-contact-popover__header">
                <p class="process-contact-popover__title" id="service-hero-contact-title">Yhteystietomme</p>
                <button
                  type="button"
                  class="process-contact-popover__close"
                  data-service-contact-close
                  aria-label="Sulje yhteystiedot"
                >×</button>
              </div>
              <p class="process-contact-popover__label">Puhelin</p>
              <div class="process-contact-popover__phones">
                <a href="tel:+358469214415">Matias Ryynänen <span>046 921 4415</span></a>
                <a href="tel:+358504796544">Miro Sorjonen <span>050 479 6544</span></a>
              </div>
              <EmailContactOptions />
              <a class="process-contact-popover__action" href="#keskustele-urakasta">Jätä yhteydenottopyyntö</a>
            </div>
          </div>
          <a class="service-page-hero__secondary" href="#valitut-kohteet">{content.hero.secondaryCta}</a>
        </div>
      </div>
    </div>
  </section>

  <div class="service-content-page">
    <ServiceContentSection
      id="uudis-ja-saneerauskohteet"
      title={content.introSection.title}
    >
      <div class="service-intro-layout">
        <div class="service-prose">
          {content.introSection.body.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href="#urakan-sisalto">{content.introSection.linkLabel}</a>
        </div>

        <figure class="service-intro-layout__media">
          <img
            src={content.introSection.image}
            alt={content.introSection.imageAlt}
            loading="lazy"
          />
        </figure>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-sisalto"
      title={content.services.title}
      intro={content.services.intro}
    >
      <div class="service-detail-grid">
        {serviceItems.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <aside class="service-content-note" aria-labelledby="tyypilliset-tyot-heading">
        <h3 id="tyypilliset-tyot-heading">{content.services.noteTitle}</h3>
        <p>{content.services.noteText}</p>
      </aside>
    </ServiceContentSection>

    <ServiceContentSection
      id="kohdetyypit"
      title={content.audiences.title}
      intro={content.audiences.intro}
    >
      <NumberedContentList items={projectTypes} columns={3} ariaLabel="LVI-urakoinnin kohderyhmät" />
    </ServiceContentSection>

    <ServiceContentSection
      id="uudisrakentaminen-ja-saneeraus"
      title={content.comparison.title}
      intro={content.comparison.intro}
    >
      <div class="service-text-columns">
        {content.comparison.columns.map((column) => (
          <article>
            <h3>{column.title}</h3>
            {column.body.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        ))}
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-eteneminen"
      title={content.process.title}
      intro={content.process.intro}
    >
      <NumberedContentList items={processSteps} columns={4} ariaLabel="LVI-urakan vaiheet" />
    </ServiceContentSection>

    <ServiceContentSection id="miksi-lvi-loisto" title={content.trust.title}>
      <div class="service-trust-layout">
        <div class="service-prose">
          {content.trust.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="service-highlight-list">
          {trustItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="valitut-kohteet"
      title={content.portfolio.title}
      intro={content.portfolio.intro}
    >
      <div class="service-reference-grid">
        {portfolioItems.map((item) => (
          <article class="service-reference service-reference--image-only">
            <figure><img src={item.image} alt={item.imageAlt} loading="lazy" /></figure>
          </article>
        ))}
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="toimialueet"
      title={content.cities.title}
      intro={content.cities.intro}
    >
      <div class="service-city-links" aria-label="Tulevat kaupunkikohtaiset LVI-urakointisivut">
        {
          cityPages.map((city) => (
            <span class="service-city-link" data-future-href={city.href}>
              <span>{city.title}</span>
              <span aria-hidden="true">→</span>
            </span>
          ))
        }
      </div>
    </ServiceContentSection>

    <FaqSection
      id="lvi-urakointi-ukk"
      title={content.faq.title}
      items={faqItems}
    />
  </div>

  <section class="contact-section" id="keskustele-urakasta" aria-labelledby="service-contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img
          src={content.contact.image}
          alt={content.contact.imageAlt}
          loading="lazy"
        />
      </figure>

      <div class="contact-panel">
        <p class="section-label">{content.contact.label}</p>
        <h2 id="service-contact-heading">{content.contact.title}</h2>
        <p class="contact-panel__intro">{content.contact.intro}</p>

        <ContactForm submitLabel={content.contact.submitLabel} />
      </div>
    </div>
  </section>

  <script>
    const initServiceContactPopover = () => {
      const trigger = document.querySelector("[data-service-contact-trigger]");
      const popover = document.querySelector("[data-service-contact-popover]");
      const closeButton = popover?.querySelector("[data-service-contact-close]");

      if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

      const setOpen = (isOpen, returnFocus = false) => {
        popover.hidden = !isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener("click", () => setOpen(popover.hidden));
      closeButton?.addEventListener("click", () => setOpen(false, true));
      popover.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("pointerdown", (event) => {
        if (!popover.hidden && !popover.parentElement?.contains(event.target as Node)) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !popover.hidden) setOpen(false, true);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initServiceContactPopover, { once: true });
    } else {
      initServiceContactPopover();
    }
  </script>
</BaseLayout>
