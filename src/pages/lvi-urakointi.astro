---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import FaqSection from "../components/FaqSection.astro";
import NumberedContentList from "../components/NumberedContentList.astro";
import ServiceContentSection from "../components/ServiceContentSection.astro";

const title = "LVI-urakointi vaativiin kohteisiin | LVI-Loisto";
const description =
  "LVI-Loisto toteuttaa LVI-urakointia uudis- ja saneerauskohteisiin pääkaupunkiseudulla.";

const serviceItems = [
  {
    title: "Käyttövesi",
    text: "Käyttövesiputkistojen asennukset ja uusimiset osana uudisrakentamista ja saneerausta. Toteutuksessa huomioidaan järjestelmän toimivuus, huollettavuus ja kohteen muut tekniset ratkaisut.",
  },
  {
    title: "Viemäröinti",
    text: "Viemärijärjestelmien asennukset ja saneeraukset sekä tarvittavat muutokset olemassa oleviin järjestelmiin. Työt sovitetaan rakenteisiin ja muihin rakennusvaiheisiin.",
  },
  {
    title: "Lämmitys",
    text: "Patteri- ja lämmitysverkostojen asennukset, muutokset ja saneeraukset. Toteutamme myös verkostojen tasapainotuksia, säätöjä ja vesivirtojen mittauksia.",
  },
  {
    title: "Jäähdytys",
    text: "Jäähdytysratkaisut erityisesti asuntoihin ja kiinteistöihin, joissa sisäolosuhteilta ja järjestelmien huomaamattomalta toteutukselta vaaditaan tavallista enemmän.",
  },
  {
    title: "Tekniset tilat",
    text: "Teknisten tilojen putkistot, laitteistot ja niiden yhteensovitus osaksi kiinteistön muuta LVI-järjestelmää. Tavoitteena on selkeä, toimiva ja helposti huollettava kokonaisuus.",
  },
  {
    title: "Lämmönjakokeskukset",
    text: "Lämmönjakokeskusten asennukset ja uusimiset taloyhtiöihin ja muihin kiinteistöihin. Kokonaisuus toteutetaan kohteen lämmitystarpeen ja olemassa olevan järjestelmän mukaan.",
  },
  {
    title: "Kaukolämpökeskukset",
    text: "Kaukolämpöön liittyvien laitteistojen ja putkistojen toteutukset sekä saneeraukset osana kiinteistön lämmitysjärjestelmän uudistamista.",
  },
  {
    title: "Maalämpö ja VILP",
    text: "Maalämpö- ja ilma-vesilämpöpumppuratkaisut uudis- ja saneerauskohteisiin. Järjestelmä sovitetaan rakennuksen lämmitystarpeeseen, teknisiin tiloihin ja olemassa olevaan lämmönjakoon.",
  },
];

const projectTypes = [
  {
    title: "Kodit ja vaativat saneerauskohteet",
    text: "Toteutamme LVI-töitä omakotitaloihin, villoihin, arvoasuntoihin sekä muihin saneerauskohteisiin. Valmiissa ja viimeistellyissä ympäristöissä korostuvat huolellinen työskentely, olemassa olevien rakenteiden huomioiminen sekä LVI-ratkaisujen sovittaminen osaksi muuta kokonaisuutta.",
  },
  {
    title: "Taloyhtiöt ja kiinteistöt",
    text: "Palvelemme rivi- ja kerrostaloyhtiöitä sekä muita kiinteistöjä LVI-saneerauksissa, lämmitysjärjestelmien uudistuksissa ja muissa teknisissä töissä. Toteutuksiin voivat kuulua esimerkiksi käyttövesi- ja patteriverkostot, lämmönjakokeskukset, vesimittarivaihdot sekä verkostojen säätö- ja mittaustyöt.",
  },
  {
    title: "Uudisrakentaminen ja rakennusliikkeet",
    text: "Toteutamme LVI-urakoita uusiin omakoti-, rivi- ja kerrostalokohteisiin sekä toimimme rakennusliikkeiden ja muiden rakentamisen ammattilaisten LVI-kumppanina. Työt sovitetaan projektin aikatauluun, LVI-suunnitelmiin ja muiden urakoitsijoiden työvaiheisiin.",
  },
];

const processSteps = [
  {
    number: "01",
    title: "Kohteen kartoitus",
    text: "Projektin alussa käydään läpi kohteen lähtötilanne, suunnitelmat, aikataulu ja urakan laajuus. Saneerauskohteissa huomioidaan myös olemassa olevat järjestelmät ja rakenteet, jotka vaikuttavat toteutukseen.",
  },
  {
    number: "02",
    title: "Suunnitelmien ja toteutuksen yhteensovitus",
    text: "LVI-ratkaisut sovitetaan kohteen rakenteisiin, teknisiin suunnitelmiin ja muiden urakoitsijoiden työvaiheisiin. Tavoitteena on tunnistaa mahdolliset yhteensovitus- ja toteutuskysymykset ennen kuin ne aiheuttavat viivästyksiä työmaalla.",
  },
  {
    number: "03",
    title: "Toteutus",
    text: "LVI-työt toteutetaan sovitun suunnitelman ja aikataulun mukaisesti. Työvaiheiden eteneminen sovitetaan muun rakentamisen kanssa, jotta kokonaisuus etenee mahdollisimman sujuvasti.",
  },
  {
    number: "04",
    title: "Tarkistus ja luovutus",
    text: "Valmiit järjestelmät tarkistetaan ennen luovutusta ja tarvittavat säädöt sekä mittaukset tehdään osana kokonaisuuden viimeistelyä. Kohde luovutetaan tilaajalle valmiina käyttöön.",
  },
];

const trustItems = [
  {
    title: "Suunnitelmallinen toteutus",
    text: "Urakan sisältö, työvaiheet ja aikataulu käydään läpi ennen toteutusta, jotta projekti etenee mahdollisimman hallitusti.",
  },
  {
    title: "Yhteistyö muiden ammattilaisten kanssa",
    text: "LVI-työt sovitetaan yhteen arkkitehtien, suunnittelijoiden, rakennusliikkeiden ja muiden urakoitsijoiden työn kanssa.",
  },
  {
    title: "Kokemus erilaisista kohteista",
    text: "Toteutamme LVI-töitä uudisrakennuksiin, saneerauskohteisiin, koteihin, taloyhtiöihin ja muihin kiinteistöihin.",
  },
  {
    title: "Huolellinen viimeistely",
    text: "Erityisesti valmiissa ja arvokkaissa ympäristöissä teknisten ratkaisujen lisäksi korostuvat siisti työnjälki ja ympäröivien rakenteiden huomioiminen.",
  },
];

const portfolioItems = [
  {
    title: "Arvoasunnon LVI-saneeraus",
    location: "Helsinki",
    type: "Saneeraus",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/taloyhtiot-kiinteistot.jpg",
    imageAlt: "Tumma märkätila arvoasunnon saneerauskohteessa",
    futureHref: "/kohteet/arvoasunnon-lvi-saneeraus-helsinki/",
  },
  {
    title: "Villan LVI-kokonaisuus",
    location: "Espoo",
    type: "Uudisrakentaminen",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/uudisrakennukset-villat.jpeg",
    imageAlt: "Laadukas kodinhoito- ja märkätila villakohteessa",
    futureHref: "/kohteet/villan-lvi-kokonaisuus-espoo/",
  },
  {
    title: "Kiinteistön tekninen saneeraus",
    location: "Vantaa",
    type: "Kiinteistö",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/arvoasunnot-saneeraus.jpeg",
    imageAlt: "Viimeistelty vaalea tila kiinteistökohteessa",
    futureHref: "/kohteet/kiinteiston-tekninen-saneeraus-vantaa/",
  },
];

const cityPages = [
  { title: "LVI-urakointi Helsinki", href: "/lvi-urakointi/helsinki/" },
  { title: "LVI-urakointi Espoo", href: "/lvi-urakointi/espoo/" },
  { title: "LVI-urakointi Vantaa", href: "/lvi-urakointi/vantaa/" },
];

const faqItems = [
  { question: "Mitä LVI-urakointi sisältää?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Millaisiin kohteisiin palvelu sopii?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Teettekö uudis- ja saneerauskohteita?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Milloin LVI-urakoitsija kannattaa ottaa mukaan?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Millä alueella LVI-Loisto toimii?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Miten tarjouspyyntö valmistellaan?", answer: "Vastaus täydennetään myöhemmin." },
];
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero" aria-labelledby="service-page-heading">
    <img
      class="service-page-hero__image"
      src="/images/home/hero-imgl1743.jpg"
      alt="Tumma viimeistelty märkätila vaativassa LVI-kohteessa"
      loading="eager"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-urakointi" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="service-page-heading">LVI-urakointi vaativiin kohteisiin</h1>
        <p>Huolellisesti suunniteltuja LVI-kokonaisuuksia uudis- ja saneerauskohteisiin.</p>
        <div class="service-page-hero__actions">
          <a class="service-page-hero__primary" href="/yhteystiedot/">Keskustele kohteestasi</a>
          <a class="service-page-hero__secondary" href="#valitut-kohteet">Katso toteutettuja kohteita</a>
        </div>
      </div>
    </div>
  </section>

  <div class="service-content-page">
    <ServiceContentSection
      id="uudis-ja-saneerauskohteet"
      title="LVI-urakointia uudis- ja saneerauskohteisiin"
    >
      <div class="service-prose">
          <p>LVI-Loisto toteuttaa LVI-urakointia uudisrakennuksiin ja saneerauskohteisiin pääkaupunkiseudulla. Palvelemme taloyhtiöitä, rakennusliikkeitä ja yksityisasiakkaita kohteissa, joissa LVI-järjestelmien toimivuus, huolellinen toteutus ja työn yhteensovittaminen muun rakentamisen kanssa ovat tärkeässä roolissa.</p>
          <p>Uudisrakentamisessa toteutamme LVI-kokonaisuuksia muun muassa omakoti-, rivi- ja kerrostalokohteisiin. Saneerauskohteissa työ voi käsittää yksittäisten järjestelmien uusimisen tai laajemman LVI-kokonaisuuden osana rakennuksen peruskorjausta. Toteutus suunnitellaan aina kohteen olemassa olevien rakenteiden, LVI-suunnitelmien ja muiden työvaiheiden mukaan.</p>
          <p>LVI-urakoitsijana huolehdimme siitä, että työ etenee suunnitelmallisesti kartoituksesta ja työvaiheiden yhteensovituksesta aina asennuksiin, tarkastuksiin ja valmiin kokonaisuuden luovutukseen. Tavoitteena on teknisesti toimiva ratkaisu, joka sopii kohteen käyttötarkoitukseen ja kestää käyttöä pitkälle tulevaisuuteen.</p>
        <a class="text-link" href="#urakan-sisalto">Tutustu urakan sisältöön</a>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-sisalto"
      title="Mitä LVI-urakointi sisältää?"
      intro="LVI-urakan sisältö määräytyy aina kohteen suunnitelmien, käyttötarkoituksen ja nykyisten järjestelmien mukaan. LVI-Loisto toteuttaa sekä yksittäisiä järjestelmiä että laajempia LVI-kokonaisuuksia uudis- ja saneerauskohteisiin."
    >
      <div class="service-detail-grid">
        {serviceItems.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="service-content-note">Tarvittaessa urakkaan voidaan yhdistää myös esimerkiksi vesimittarivaihtoja sekä käyttövesi- ja patteriverkostojen muita muutostöitä.</p>
    </ServiceContentSection>

    <ServiceContentSection
      id="kohdetyypit"
      title="Kenelle teemme LVI-urakointia?"
      intro="LVI-Loisto toteuttaa LVI-urakointia erilaisiin asuin- ja kiinteistökohteisiin. Toteutuksen laajuus määritellään aina kohteen, suunnitelmien ja tilaajan tarpeiden mukaan."
    >
      <NumberedContentList items={projectTypes} columns={3} ariaLabel="LVI-urakoinnin kohderyhmät" />
    </ServiceContentSection>

    <ServiceContentSection
      id="uudisrakentaminen-ja-saneeraus"
      title="LVI-urakointi uudisrakentamisessa ja saneerauksissa"
      intro="Uudisrakentaminen ja saneeraus asettavat LVI-urakalle erilaiset lähtökohdat. Uudessa kohteessa järjestelmät voidaan toteuttaa alusta lähtien suunnitelmien mukaisena kokonaisuutena, kun taas saneerauksessa uudet ratkaisut täytyy sovittaa olemassa oleviin rakenteisiin ja järjestelmiin."
    >
      <div class="service-text-columns">
        <article>
          <h3>Uudisrakentaminen</h3>
          <p>Uudiskohteessa LVI-urakointi alkaa suunnitelmien läpikäynnistä ja työvaiheiden yhteensovittamisesta muun rakentamisen kanssa. Toteutamme LVI-järjestelmiä omakoti-, rivi- ja kerrostalokohteisiin sekä muihin uudisrakennuksiin.</p>
          <p>Urakka voi sisältää esimerkiksi käyttövesi- ja viemärijärjestelmät, lämmityksen, jäähdytyksen sekä teknisten tilojen ja lämmitysjärjestelmien toteutuksen. Työ etenee projektin aikataulun mukaisesti yhdessä muiden suunnittelijoiden ja urakoitsijoiden kanssa.</p>
        </article>
        <article>
          <h3>Saneerauskohteet</h3>
          <p>Saneerauksessa lähtökohtana ovat rakennuksen nykyiset järjestelmät ja rakenteet. Ennen toteutusta arvioidaan, mitä voidaan säilyttää, mitä täytyy uusia ja miten uudet LVI-ratkaisut voidaan toteuttaa mahdollisimman hallitusti osana muuta remonttia.</p>
          <p>Toteutamme sekä yksittäisiä LVI-muutoksia että laajempia saneerauskokonaisuuksia. Työssä korostuvat huolellinen vaiheistus, olemassa olevien pintojen ja rakenteiden huomioiminen sekä uusien järjestelmien toimiva yhteensovitus vanhan rakennuksen kanssa.</p>
        </article>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-eteneminen"
      title="Näin LVI-urakka etenee"
      intro="LVI-urakan onnistuminen perustuu selkeään suunnitteluun, oikeaan vaiheistukseen ja siihen, että työ sovitetaan yhteen muun rakentamisen kanssa. LVI-Loisto vie projektin eteenpäin hallitusti lähtötilanteesta valmiiseen kokonaisuuteen."
    >
      <NumberedContentList items={processSteps} columns={4} ariaLabel="LVI-urakan vaiheet" />
    </ServiceContentSection>

    <ServiceContentSection id="miksi-lvi-loisto" title="LVI-Loisto LVI-urakoitsijana">
      <div class="service-trust-layout">
        <div class="service-prose">
          <p>LVI-urakoitsijan tehtävä ei ole pelkästään asentaa suunnitelmiin merkittyjä järjestelmiä. Vaativassa rakennus- tai saneeraushankkeessa olennaista on ymmärtää kokonaisuutta, sovittaa LVI-työt muihin työvaiheisiin ja varmistaa, että tekninen toteutus toimii myös käytännössä.</p>
          <p>LVI-Loisto toteuttaa urakoita niin yksityisille tilaajille, taloyhtiöille kuin rakennusalan ammattilaisille. Erityisesti vaativissa kohteissa kiinnitämme huomiota työn teknisen toimivuuden lisäksi toteutuksen siisteyteen, yksityiskohtiin ja siihen, miten LVI-ratkaisut istuvat osaksi valmista rakennusta.</p>
        </div>
        <div class="service-highlight-list">
          {trustItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="valitut-kohteet"
      title="Valittuja LVI-urakointikohteita"
      intro="Kohdetiedot ja linkit täydennetään, kun referenssisivut julkaistaan."
    >
      <div class="service-reference-grid">
        {portfolioItems.map((item) => (
          <article class="service-reference" data-future-href={item.futureHref}>
            <figure><img src={item.image} alt={item.imageAlt} loading="lazy" /></figure>
            <p class="service-reference__meta">{item.location} · {item.type}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="toimialueet"
      title="LVI-urakointi pääkaupunkiseudulla"
      intro="Kaupunkikohtaiset palvelusivut lisätään tähän rakenteeseen myöhemmin."
    >
      <div class="service-city-links" aria-label="Tulevat kaupunkikohtaiset LVI-urakointisivut">
        {
          cityPages.map((city) => (
            <span class="service-city-link" data-future-href={city.href}>
              <span>{city.title}</span>
              <span aria-hidden="true">→</span>
            </span>
          ))
        }
      </div>
    </ServiceContentSection>

    <FaqSection
      id="lvi-urakointi-ukk"
      title="Usein kysyttyä LVI-urakoinnista"
      intro="Kysymykset ja vastaukset täydennetään osio kerrallaan."
      items={faqItems}
    />
  </div>

  <section class="contact-section" id="keskustele-urakasta" aria-labelledby="service-contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img
          src="/images/home/contact-shower-cropped.jpg"
          alt="Kultainen sadesuihku viimeistellyssä tummassa märkätilassa"
          loading="lazy"
        />
      </figure>

      <div class="contact-panel">
        <p class="section-label">Yhteydenotto</p>
        <h2 id="service-contact-heading">Keskustele LVI-urakastasi</h2>
        <p class="contact-panel__intro">Kerro millaisesta kohteesta on kyse, missä se sijaitsee ja mitä LVI-kokonaisuutta tarvitset. Palaamme asiaan ja arvioimme, miten projekti kannattaa viedä eteenpäin.</p>

        <ContactForm submitLabel="Lähetä tarjouspyyntö" />
      </div>
    </div>
  </section>
</BaseLayout>
