---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import FaqSection from "../components/FaqSection.astro";
import NumberedContentList from "../components/NumberedContentList.astro";
import ServiceContentSection from "../components/ServiceContentSection.astro";

const title = "LVI-urakointi vaativiin kohteisiin | LVI-Loisto";
const description =
  "LVI-Loisto toteuttaa LVI-urakointia uudis- ja saneerauskohteisiin pääkaupunkiseudulla.";

const serviceItems = [
  {
    title: "Käyttövesi",
    text: "Käyttövesiputkistojen asennukset, uusimiset ja muutostyöt uudis- ja saneerauskohteissa.",
  },
  {
    title: "Viemäröinti",
    text: "Viemäriputkistojen asennukset, saneeraukset ja muutokset osana rakennuksen LVI-kokonaisuutta.",
  },
  {
    title: "Lämmitys",
    text: "Patteri- ja lämmitysverkostojen asennukset ja saneeraukset sekä verkostojen tasapainotus, säädöt ja vesivirtojen mittaukset.",
  },
  {
    title: "Jäähdytys",
    text: "Jäähdytysratkaisut asuntoihin ja kiinteistöihin, joissa sisäolosuhteilta ja toteutuksen viimeistelyltä vaaditaan tavallista enemmän.",
  },
  {
    title: "Tekniset tilat",
    text: "Teknisten tilojen putkistot ja laiteasennukset sekä järjestelmien yhteensovitus selkeäksi ja huollettavaksi kokonaisuudeksi.",
  },
  {
    title: "Lämmönjakokeskukset",
    text: "Lämmönjakokeskusten asennukset ja uusimiset taloyhtiöihin ja muihin kiinteistöihin.",
  },
  {
    title: "Kaukolämpökeskukset",
    text: "Kaukolämpöön liittyvien laitteistojen ja putkistojen toteutukset sekä saneeraukset.",
  },
  {
    title: "Maalämpö ja VILP",
    text: "Maalämpö- ja ilma-vesilämpöpumppuratkaisujen toteutukset uudis- ja saneerauskohteisiin.",
  },
];

const projectTypes = [
  {
    title: "Kodit ja vaativat saneerauskohteet",
    text: "LVI-töitä omakotitaloihin, villoihin, asuntoihin ja muihin saneerauskohteisiin. Valmiissa ympäristössä korostuvat huolellinen työskentely, rakenteiden huomioiminen ja siisti viimeistely.",
  },
  {
    title: "Taloyhtiöt ja kiinteistöt",
    text: "LVI-saneerauksia sekä lämmitys-, käyttövesi- ja muita teknisiä töitä rivi- ja kerrostaloyhtiöihin sekä muihin kiinteistöihin. Toteutuksiin voivat kuulua esimerkiksi verkostot, lämmönjakokeskukset, vesimittarit sekä säätö- ja mittaustyöt.",
  },
  {
    title: "Uudisrakentaminen ja rakennusliikkeet",
    text: "LVI-urakointia uusiin omakoti-, rivi- ja kerrostalokohteisiin sekä rakennusliikkeiden ja muiden rakentamisen ammattilaisten projekteihin. Työ sovitetaan projektin aikatauluun ja muiden urakoitsijoiden työvaiheisiin.",
  },
];

const processSteps = [
  {
    number: "01",
    title: "Kohteen kartoitus",
    text: "Käymme läpi kohteen lähtötilanteen, suunnitelmat, urakan laajuuden ja aikataulun.",
  },
  {
    number: "02",
    title: "Toteutuksen yhteensovitus",
    text: "LVI-työt sovitetaan rakenteisiin, teknisiin suunnitelmiin ja muiden urakoitsijoiden työvaiheisiin.",
  },
  {
    number: "03",
    title: "Toteutus",
    text: "Asennukset ja muut LVI-työt tehdään sovitun suunnitelman ja työmaan aikataulun mukaisesti.",
  },
  {
    number: "04",
    title: "Tarkistus ja luovutus",
    text: "Valmis kokonaisuus tarkistetaan ja tarvittavat säädöt ja mittaukset tehdään ennen luovutusta.",
  },
];

const trustItems = [
  {
    title: "Suunnitelmallinen toteutus",
    text: "Urakan sisältö ja työvaiheet käydään läpi ennen toteutusta.",
  },
  {
    title: "Yhteistyö muiden ammattilaisten kanssa",
    text: "LVI-työt sovitetaan suunnittelijoiden, rakennusliikkeiden ja muiden urakoitsijoiden työhön.",
  },
  {
    title: "Monipuoliset kohteet",
    text: "Toteutamme töitä uudisrakennuksiin, saneerauskohteisiin, taloyhtiöihin ja yksityisiin kiinteistöihin.",
  },
  {
    title: "Huolellinen viimeistely",
    text: "Valmiissa ympäristössä huomioimme teknisen toteutuksen lisäksi ympäröivät pinnat ja rakenteet.",
  },
];

const portfolioItems = [
  {
    image: "/images/home/taloyhtiot-kiinteistot.jpg",
    imageAlt: "Tumma viimeistelty märkätila",
  },
  {
    image: "/images/home/uudisrakennukset-villat.jpeg",
    imageAlt: "Viimeistelty kodinhoito- ja märkätila",
  },
  {
    image: "/images/home/arvoasunnot-saneeraus.jpeg",
    imageAlt: "Vaalea viimeistelty sisätila",
  },
];

const cityPages = [
  { title: "LVI-urakointi Helsinki", href: "/lvi-urakointi/helsinki/" },
  { title: "LVI-urakointi Espoo", href: "/lvi-urakointi/espoo/" },
  { title: "LVI-urakointi Vantaa", href: "/lvi-urakointi/vantaa/" },
];

const faqItems = [
  { question: "Mitä LVI-urakointi sisältää?", answer: "LVI-urakka voi sisältää esimerkiksi käyttövesi- ja viemäriputkistoja, lämmitysjärjestelmiä, teknisiä tiloja sekä erilaisia saneeraus- ja muutostöitä. Tarkka sisältö määräytyy aina kohteen suunnitelmien ja tarpeiden mukaan." },
  { question: "Millaisiin kohteisiin LVI-Loisto tekee urakointia?", answer: "Toteutamme LVI-töitä muun muassa omakoti-, rivi- ja kerrostalokohteisiin, taloyhtiöihin sekä muihin asuin- ja kiinteistökohteisiin." },
  { question: "Teettekö sekä uudisrakentamista että saneerauksia?", answer: "Kyllä. Toteutamme LVI-urakointia sekä uudisrakennuksiin että olemassa olevien rakennusten saneeraus- ja muutostöihin." },
  { question: "Milloin LVI-urakoitsija kannattaa ottaa mukaan projektiin?", answer: "Mitä aikaisemmin LVI-toteutusta voidaan tarkastella suhteessa suunnitelmiin ja muihin työvaiheisiin, sitä helpompi mahdolliset yhteensovitustarpeet on huomioida ennen rakentamisen etenemistä." },
  { question: "Millä alueella LVI-Loisto toimii?", answer: "Toimimme ensisijaisesti Helsingissä, Espoossa, Vantaalla ja muualla pääkaupunkiseudulla sekä valituissa kohteissa myös muualla Suomessa." },
  { question: "Mitä tarjouspyyntöön kannattaa liittää?", answer: "Kerro ainakin kohteen sijainti, työn arvioitu laajuus ja projektin aikataulu. Jos LVI-suunnitelmat tai muut kohdetiedot ovat jo saatavilla, ne helpottavat urakan arviointia." },
];
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero" aria-labelledby="service-page-heading">
    <img
      class="service-page-hero__image"
      src="/images/home/hero-imgl1743.jpg"
      alt="Tumma viimeistelty märkätila vaativassa LVI-kohteessa"
      loading="eager"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-urakointi" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="service-page-heading">LVI-urakointi vaativiin kohteisiin</h1>
        <p>LVI-urakointia uudis- ja saneerauskohteisiin pääkaupunkiseudulla. Toteutamme toimivia ja huolellisesti viimeisteltyjä LVI-kokonaisuuksia koteihin, taloyhtiöihin ja kiinteistöihin.</p>
        <div class="service-page-hero__actions">
          <div class="service-page-hero__contact">
            <button
              class="service-page-hero__primary"
              type="button"
              aria-controls="service-hero-contact-popover"
              aria-expanded="false"
              data-service-contact-trigger
            >Keskustele kohteestasi</button>
            <div
              class="process-contact-popover service-page-contact-popover"
              id="service-hero-contact-popover"
              role="region"
              aria-labelledby="service-hero-contact-title"
              data-service-contact-popover
              hidden
            >
              <div class="process-contact-popover__header">
                <h3 id="service-hero-contact-title">Yhteystietomme</h3>
                <button
                  type="button"
                  class="process-contact-popover__close"
                  data-service-contact-close
                  aria-label="Sulje yhteystiedot"
                >×</button>
              </div>
              <p class="process-contact-popover__label">Puhelin</p>
              <div class="process-contact-popover__phones">
                <a href="tel:+358469214415">Matias Ryynänen <span>046 921 4415</span></a>
                <a href="tel:+358504796544">Miro Sorjonen <span>050 479 6544</span></a>
              </div>
              <a class="process-contact-popover__action" href="mailto:matias.ryynanen@lviloisto.fi">Lähetä sähköpostia</a>
              <a class="process-contact-popover__action" href="#keskustele-urakasta">Jätä yhteydenottopyyntö</a>
            </div>
          </div>
          <a class="service-page-hero__secondary" href="#valitut-kohteet">Katso toteutettuja kohteita</a>
        </div>
      </div>
    </div>
  </section>

  <div class="service-content-page">
    <ServiceContentSection
      id="uudis-ja-saneerauskohteet"
      title="LVI-urakointia uudis- ja saneerauskohteisiin"
    >
      <div class="service-intro-layout">
        <div class="service-prose">
          <p>LVI-Loisto toteuttaa LVI-urakointia uudisrakennuksiin ja saneerauskohteisiin pääkaupunkiseudulla. Palvelemme taloyhtiöitä, rakennusliikkeitä ja yksityisasiakkaita aina yksittäisistä järjestelmäuudistuksista laajempiin LVI-kokonaisuuksiin.</p>
          <p>Uudisrakentamisessa toteutamme LVI-töitä muun muassa omakoti-, rivi- ja kerrostalokohteisiin. Saneerauksissa työ voi käsittää esimerkiksi käyttövesi- tai lämmitysverkoston uusimisen, teknisen tilan muutoksia tai LVI-järjestelmien päivittämistä osana laajempaa remonttia.</p>
          <p>Urakka sovitetaan kohteen suunnitelmiin, rakenteisiin ja muiden urakoitsijoiden työvaiheisiin. Tavoitteena on toimiva ja huollettava kokonaisuus, joka palvelee rakennuksen käyttöä pitkälle tulevaisuuteen.</p>
          <a class="text-link" href="#urakan-sisalto">Tutustu urakan sisältöön</a>
        </div>

        <figure class="service-intro-layout__media">
          <img
            src="/images/home/service-imgl1754.jpg"
            alt="Viimeistelty kylpyhuone LVI-urakointikohteessa"
            loading="lazy"
          />
        </figure>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-sisalto"
      title="Mitä LVI-urakointi sisältää?"
      intro="LVI-urakan sisältö määräytyy kohteen, suunnitelmien ja olemassa olevien järjestelmien mukaan. Toteutamme sekä yksittäisiä LVI-töitä että laajempia kokonaisuuksia."
    >
      <div class="service-detail-grid">
        {serviceItems.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <aside class="service-content-note" aria-labelledby="tyypilliset-tyot-heading">
        <h3 id="tyypilliset-tyot-heading">Tyypillisiä LVI-urakan töitä</h3>
        <p>LVI-urakka voi käsittää yhden järjestelmän uusimisen tai useita rakennuksen teknisiä järjestelmiä. Tyypillisiä töitä ovat esimerkiksi käyttövesi- ja viemäriputkistojen asennukset, patteri- ja lämmitysverkostojen saneeraukset, vesimittarien vaihdot, verkostojen tasapainotus ja mittaukset sekä teknisten tilojen ja lämmitysjärjestelmien muutostyöt.</p>
      </aside>
    </ServiceContentSection>

    <ServiceContentSection
      id="kohdetyypit"
      title="Kenelle teemme LVI-urakointia?"
      intro="Toteutamme LVI-urakoita erilaisiin asuin- ja kiinteistökohteisiin. Urakan laajuus ja toteutustapa suunnitellaan aina kohteen ja tilaajan tarpeiden mukaan."
    >
      <NumberedContentList items={projectTypes} columns={3} ariaLabel="LVI-urakoinnin kohderyhmät" />
    </ServiceContentSection>

    <ServiceContentSection
      id="uudisrakentaminen-ja-saneeraus"
      title="LVI-urakointi uudisrakentamisessa ja saneerauksissa"
      intro="Uudisrakennuksessa LVI-järjestelmät rakennetaan osaksi kokonaisuutta alusta lähtien. Saneerauksessa uudet ratkaisut täytyy puolestaan sovittaa olemassa oleviin rakenteisiin ja järjestelmiin."
    >
      <div class="service-text-columns">
        <article>
          <h3>Uudisrakentaminen</h3>
          <p>Uudiskohteessa LVI-urakka etenee suunnitelmien ja rakennushankkeen aikataulun mukaisesti. Toteutus voi sisältää käyttövesi- ja viemärijärjestelmät, lämmityksen, tekniset tilat sekä kohteen muut LVI-ratkaisut.</p>
          <p>Huolellinen yhteensovitus muun rakentamisen kanssa auttaa varmistamaan, että putkireitit, laitteiden sijoittelu ja tekniset varaukset voidaan toteuttaa suunnitellusti.</p>
        </article>
        <article>
          <h3>Saneerauskohteet</h3>
          <p>Saneerauksessa lähtökohtana ovat rakennuksen nykyiset rakenteet ja tekniset järjestelmät. Ennen toteutusta selvitetään, mitä voidaan säilyttää, mitä uusitaan ja miten uudet ratkaisut voidaan liittää olemassa olevaan kokonaisuuteen.</p>
          <p>Työ voi käsittää yksittäisiä muutoksia tai laajemman LVI-saneerauksen osana rakennuksen peruskorjausta.</p>
        </article>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="urakan-eteneminen"
      title="Näin LVI-urakka etenee"
      intro="Selkeä työnjako ja suunnitelmallinen eteneminen helpottavat sekä tilaajan että muiden projektissa työskentelevien osapuolten työtä."
    >
      <NumberedContentList items={processSteps} columns={4} ariaLabel="LVI-urakan vaiheet" />
    </ServiceContentSection>

    <ServiceContentSection id="miksi-lvi-loisto" title="LVI-Loisto LVI-urakoitsijana">
      <div class="service-trust-layout">
        <div class="service-prose">
          <p>LVI-urakoitsijan tehtävä ei ole ainoastaan asentaa suunnitelmiin merkittyjä putkia ja laitteita. Rakennus- ja saneeraushankkeissa LVI-töiden täytyy sopia yhteen rakenteiden, muiden teknisten järjestelmien ja projektin aikataulun kanssa.</p>
          <p>LVI-Loisto toteuttaa urakoita yksityisille tilaajille, taloyhtiöille ja rakennusalan ammattilaisille. Vaativissa kohteissa kiinnitämme teknisen toimivuuden lisäksi huomiota työn siisteyteen, yksityiskohtiin ja siihen, että valmiit ratkaisut sopivat rakennuksen muuhun kokonaisuuteen.</p>
        </div>
        <div class="service-highlight-list">
          {trustItems.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="valitut-kohteet"
      title="Valittuja LVI-urakointikohteita"
      intro="Tutustu esimerkkeihin LVI-Loiston toteuttamista uudis-, saneeraus- ja kiinteistökohteista."
    >
      <div class="service-reference-grid">
        {portfolioItems.map((item) => (
          <article class="service-reference service-reference--image-only">
            <figure><img src={item.image} alt={item.imageAlt} loading="lazy" /></figure>
          </article>
        ))}
      </div>
    </ServiceContentSection>

    <ServiceContentSection
      id="toimialueet"
      title="LVI-urakointi pääkaupunkiseudulla"
      intro="LVI-Loisto toteuttaa LVI-urakointia Helsingissä, Espoossa, Vantaalla ja muualla pääkaupunkiseudulla. Toimipisteemme sijaitsee Vantaalla."
    >
      <div class="service-city-links" aria-label="Tulevat kaupunkikohtaiset LVI-urakointisivut">
        {
          cityPages.map((city) => (
            <span class="service-city-link" data-future-href={city.href}>
              <span>{city.title}</span>
              <span aria-hidden="true">→</span>
            </span>
          ))
        }
      </div>
    </ServiceContentSection>

    <FaqSection
      id="lvi-urakointi-ukk"
      title="Usein kysyttyä LVI-urakoinnista"
      items={faqItems}
    />
  </div>

  <section class="contact-section" id="keskustele-urakasta" aria-labelledby="service-contact-heading">
    <div class="contact-section__inner">
      <figure class="contact-section__media">
        <img
          src="/images/home/contact-shower-cropped.jpg"
          alt="Kultainen sadesuihku viimeistellyssä tummassa märkätilassa"
          loading="lazy"
        />
      </figure>

      <div class="contact-panel">
        <p class="section-label">Yhteydenotto</p>
        <h2 id="service-contact-heading">Keskustele LVI-urakastasi</h2>
        <p class="contact-panel__intro">Kerro meille kohteesta, sen sijainnista ja tarvitsemastasi LVI-kokonaisuudesta. Käymme lähtötiedot läpi ja arvioimme, miten projekti kannattaa toteuttaa.</p>

        <ContactForm submitLabel="Lähetä tarjouspyyntö" />
      </div>
    </div>
  </section>

  <script>
    const initServiceContactPopover = () => {
      const trigger = document.querySelector("[data-service-contact-trigger]");
      const popover = document.querySelector("[data-service-contact-popover]");
      const closeButton = popover?.querySelector("[data-service-contact-close]");

      if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

      const setOpen = (isOpen, returnFocus = false) => {
        popover.hidden = !isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener("click", () => setOpen(popover.hidden));
      closeButton?.addEventListener("click", () => setOpen(false, true));
      popover.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("pointerdown", (event) => {
        if (!popover.hidden && !popover.parentElement?.contains(event.target as Node)) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !popover.hidden) setOpen(false, true);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initServiceContactPopover, { once: true });
    } else {
      initServiceContactPopover();
    }
  </script>
</BaseLayout>
