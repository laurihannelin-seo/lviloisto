---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqSection from "../components/FaqSection.astro";
import SplitCta from "../components/SplitCta.astro";

const title = "LVI-urakointi vaativiin kohteisiin | LVI-Loisto";
const description =
  "LVI-Loisto toteuttaa LVI-urakointia uudis- ja saneerauskohteisiin pääkaupunkiseudulla.";

const serviceItems = [
  {
    title: "Käyttövesi",
    text: "Käyttövesiputkistojen asennukset ja uusimiset osana uudisrakentamista ja saneerausta. Toteutuksessa huomioidaan järjestelmän toimivuus, huollettavuus ja kohteen muut tekniset ratkaisut.",
  },
  {
    title: "Viemäröinti",
    text: "Viemärijärjestelmien asennukset ja saneeraukset sekä tarvittavat muutokset olemassa oleviin järjestelmiin. Työt sovitetaan rakenteisiin ja muihin rakennusvaiheisiin.",
  },
  {
    title: "Lämmitys",
    text: "Patteri- ja lämmitysverkostojen asennukset, muutokset ja saneeraukset. Toteutamme myös verkostojen tasapainotuksia, säätöjä ja vesivirtojen mittauksia.",
  },
  {
    title: "Jäähdytys",
    text: "Jäähdytysratkaisut erityisesti asuntoihin ja kiinteistöihin, joissa sisäolosuhteilta ja järjestelmien huomaamattomalta toteutukselta vaaditaan tavallista enemmän.",
  },
  {
    title: "Tekniset tilat",
    text: "Teknisten tilojen putkistot, laitteistot ja niiden yhteensovitus osaksi kiinteistön muuta LVI-järjestelmää. Tavoitteena on selkeä, toimiva ja helposti huollettava kokonaisuus.",
  },
  {
    title: "Lämmönjakokeskukset",
    text: "Lämmönjakokeskusten asennukset ja uusimiset taloyhtiöihin ja muihin kiinteistöihin. Kokonaisuus toteutetaan kohteen lämmitystarpeen ja olemassa olevan järjestelmän mukaan.",
  },
  {
    title: "Kaukolämpökeskukset",
    text: "Kaukolämpöön liittyvien laitteistojen ja putkistojen toteutukset sekä saneeraukset osana kiinteistön lämmitysjärjestelmän uudistamista.",
  },
  {
    title: "Maalämpö ja VILP",
    text: "Maalämpö- ja ilma-vesilämpöpumppuratkaisut uudis- ja saneerauskohteisiin. Järjestelmä sovitetaan rakennuksen lämmitystarpeeseen, teknisiin tiloihin ja olemassa olevaan lämmönjakoon.",
  },
];

const projectTypes = [
  {
    title: "Kodit ja vaativat saneerauskohteet",
    text: "Arvoasunnot, omakotitalot, villat ja muut vaativat saneerauskohteet.",
    image: "/images/home/taloyhtiot-kiinteistot.jpg",
    imageAlt: "Tumma viimeistelty märkätila saneerauskohteessa",
  },
  {
    title: "Taloyhtiöt ja kiinteistöt",
    text: "Rivitalot, kerrostalot, kiinteistöt ja niiden tekniset järjestelmät.",
    image: "/images/home/arvoasunnot-saneeraus.jpeg",
    imageAlt: "Vaalea viimeistelty kylpyhuone kiinteistökohteessa",
  },
  {
    title: "Uudisrakentaminen ja rakennusliikkeet",
    text: "Uudisrakennukset sekä yhteistyö rakennusliikkeiden ja rakentamisen ammattilaisten kanssa.",
    image: "/images/home/about-imgl1779.jpg",
    imageAlt: "Moderni viimeistelty sisätila uudisrakennuksessa",
  },
];

const processSteps = [
  {
    number: "01",
    title: "Kohteen kartoitus",
    text: "Lähtötiedot, tavoitteet ja rajaukset kootaan yhteen.",
  },
  {
    number: "02",
    title: "Suunnitelmien ja toteutuksen yhteensovitus",
    text: "Ratkaisut sovitetaan rakenteisiin ja työmaan aikatauluun.",
  },
  {
    number: "03",
    title: "Toteutus",
    text: "Urakka toteutetaan sovitun laajuuden ja aikataulun mukaan.",
  },
  {
    number: "04",
    title: "Tarkistus ja luovutus",
    text: "Valmis kokonaisuus tarkistetaan ennen luovutusta.",
  },
];

const trustItems = [
  "Suunnitelmallinen projektinhallinta",
  "Huolellinen ja siisti toteutus",
  "Yhteistyö suunnittelijoiden ja urakoitsijoiden kanssa",
  "Kohteeseen sovitetut tekniset ratkaisut",
  "Dokumentoitu tarkistus ja luovutus",
];

const portfolioItems = [
  {
    title: "Arvoasunnon LVI-saneeraus",
    location: "Helsinki",
    type: "Saneeraus",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/taloyhtiot-kiinteistot.jpg",
    imageAlt: "Tumma märkätila arvoasunnon saneerauskohteessa",
    futureHref: "/kohteet/arvoasunnon-lvi-saneeraus-helsinki/",
  },
  {
    title: "Villan LVI-kokonaisuus",
    location: "Espoo",
    type: "Uudisrakentaminen",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/uudisrakennukset-villat.jpeg",
    imageAlt: "Laadukas kodinhoito- ja märkätila villakohteessa",
    futureHref: "/kohteet/villan-lvi-kokonaisuus-espoo/",
  },
  {
    title: "Kiinteistön tekninen saneeraus",
    location: "Vantaa",
    type: "Kiinteistö",
    text: "Lyhyt kohdekuvaus täydennetään referenssin valmistuessa.",
    image: "/images/home/arvoasunnot-saneeraus.jpeg",
    imageAlt: "Viimeistelty vaalea tila kiinteistökohteessa",
    futureHref: "/kohteet/kiinteiston-tekninen-saneeraus-vantaa/",
  },
];

const cityPages = [
  { title: "LVI-urakointi Helsinki", href: "/lvi-urakointi/helsinki/" },
  { title: "LVI-urakointi Espoo", href: "/lvi-urakointi/espoo/" },
  { title: "LVI-urakointi Vantaa", href: "/lvi-urakointi/vantaa/" },
];

const faqItems = [
  { question: "Mitä LVI-urakointi sisältää?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Millaisiin kohteisiin palvelu sopii?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Teettekö uudis- ja saneerauskohteita?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Milloin LVI-urakoitsija kannattaa ottaa mukaan?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Millä alueella LVI-Loisto toimii?", answer: "Vastaus täydennetään myöhemmin." },
  { question: "Miten tarjouspyyntö valmistellaan?", answer: "Vastaus täydennetään myöhemmin." },
];
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero" aria-labelledby="service-page-heading">
    <img
      class="service-page-hero__image"
      src="/images/home/hero-imgl1743.jpg"
      alt="Tumma viimeistelty märkätila vaativassa LVI-kohteessa"
      loading="eager"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-urakointi" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="service-page-heading">LVI-urakointi vaativiin kohteisiin</h1>
        <p>Huolellisesti suunniteltuja LVI-kokonaisuuksia uudis- ja saneerauskohteisiin.</p>
        <div class="service-page-hero__actions">
          <a class="service-page-hero__primary" href="/yhteystiedot/">Keskustele kohteestasi</a>
          <a class="service-page-hero__secondary" href="#valitut-kohteet">Katso toteutettuja kohteita</a>
        </div>
      </div>
    </div>
  </section>

  <section class="service-editorial-split" id="uudis-ja-saneerauskohteet">
    <div class="service-editorial-split__inner page-shell">
      <div class="service-editorial-split__content">
        <h2>LVI-urakointia uudis- ja saneerauskohteisiin</h2>
        <div class="service-editorial-split__body">
          <p>LVI-Loisto toteuttaa LVI-urakointia uudisrakennuksiin ja saneerauskohteisiin pääkaupunkiseudulla. Palvelemme taloyhtiöitä, rakennusliikkeitä ja yksityisasiakkaita kohteissa, joissa LVI-järjestelmien toimivuus, huolellinen toteutus ja työn yhteensovittaminen muun rakentamisen kanssa ovat tärkeässä roolissa.</p>
          <p>Uudisrakentamisessa toteutamme LVI-kokonaisuuksia muun muassa omakoti-, rivi- ja kerrostalokohteisiin. Saneerauskohteissa työ voi käsittää yksittäisten järjestelmien uusimisen tai laajemman LVI-kokonaisuuden osana rakennuksen peruskorjausta. Toteutus suunnitellaan aina kohteen olemassa olevien rakenteiden, LVI-suunnitelmien ja muiden työvaiheiden mukaan.</p>
          <p>LVI-urakoitsijana huolehdimme siitä, että työ etenee suunnitelmallisesti kartoituksesta ja työvaiheiden yhteensovituksesta aina asennuksiin, tarkastuksiin ja valmiin kokonaisuuden luovutukseen. Tavoitteena on teknisesti toimiva ratkaisu, joka sopii kohteen käyttötarkoitukseen ja kestää käyttöä pitkälle tulevaisuuteen.</p>
        </div>
        <a class="text-link" href="#urakan-sisalto">Tutustu urakan sisältöön</a>
      </div>
      <figure class="service-editorial-split__media">
        <img
          src="/images/home/about-imgl1779.jpg"
          alt="Viimeistelty sisätila LVI-urakointikohteessa"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <section class="service-scope-section" id="urakan-sisalto" aria-labelledby="scope-heading">
    <div class="service-scope-section__inner page-shell">
      <div class="service-scope-section__header">
        <h2 id="scope-heading">Mitä LVI-urakointi sisältää?</h2>
        <p>LVI-urakan sisältö määräytyy aina kohteen suunnitelmien, käyttötarkoituksen ja nykyisten järjestelmien mukaan. LVI-Loisto toteuttaa sekä yksittäisiä järjestelmiä että laajempia LVI-kokonaisuuksia uudis- ja saneerauskohteisiin.</p>
      </div>
      <ul class="service-scope-list">
        {serviceItems.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      <p class="service-scope-section__note">Tarvittaessa urakkaan voidaan yhdistää myös esimerkiksi vesimittarivaihtoja sekä käyttövesi- ja patteriverkostojen muita muutostöitä.</p>
    </div>
  </section>

  <section class="service-project-types" id="kohdetyypit" aria-labelledby="project-types-heading">
    <div class="service-project-types__inner page-shell">
      <div class="service-project-types__header">
        <h2 id="project-types-heading">Kenelle teemme LVI-urakointia?</h2>
        <p>Palvelemme yksityisiä, taloyhtiöitä, kiinteistöjä ja rakentamisen ammattilaisia.</p>
      </div>
      <div class="service-project-types__grid">
        {
          projectTypes.map((item) => (
            <article class="service-project-type">
              <figure><img src={item.image} alt={item.imageAlt} loading="lazy" /></figure>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="service-comparison" id="uudisrakentaminen-ja-saneeraus" aria-labelledby="comparison-heading">
    <div class="service-comparison__inner page-shell">
      <h2 id="comparison-heading">LVI-urakointi uudisrakentamisessa ja saneerauksissa</h2>
      <div class="service-comparison__grid">
        <article>
          <h3>Uudisrakentaminen</h3>
          <p>Sisältö täydennetään myöhemmin suunnittelusta, yhteensovituksesta ja toteutuksesta.</p>
        </article>
        <article>
          <h3>Saneerauskohteet</h3>
          <p>Sisältö täydennetään myöhemmin kartoituksesta, rakenteista ja hallitusta toteutuksesta.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="service-process-section" id="urakan-eteneminen" aria-labelledby="service-process-heading">
    <div class="service-process-section__inner page-shell">
      <div class="service-section-heading">
        <h2 id="service-process-heading">Näin LVI-urakka etenee</h2>
        <p>Selkeä etenemismalli pitää suunnittelun, toteutuksen ja luovutuksen hallinnassa.</p>
      </div>
      <ol class="service-process-list">
        {processSteps.map((step) => (
          <li>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="service-trust-section" id="miksi-lvi-loisto" aria-labelledby="trust-heading">
    <div class="service-trust-section__inner page-shell">
      <div class="service-trust-section__copy">
        <h2 id="trust-heading">LVI-Loisto LVI-urakoitsijana</h2>
        <p>Nostojen tarkemmat perustelut täydennetään sisällöntuotannon yhteydessä.</p>
      </div>
      <div class="service-trust-list">
        {trustItems.map((item) => <p>{item}</p>)}
      </div>
    </div>
  </section>

  <section class="service-references" id="valitut-kohteet" aria-labelledby="references-heading">
    <div class="service-references__inner page-shell">
      <div class="service-section-heading">
        <h2 id="references-heading">Valittuja LVI-urakointikohteita</h2>
        <p>Kohdetiedot ja linkit täydennetään, kun referenssisivut julkaistaan.</p>
      </div>
      <div class="service-reference-grid">
        {portfolioItems.map((item) => (
          <article class="service-reference" data-future-href={item.futureHref}>
            <figure><img src={item.image} alt={item.imageAlt} loading="lazy" /></figure>
            <p class="service-reference__meta">{item.location} · {item.type}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-city-section" id="toimialueet" aria-labelledby="city-heading">
    <div class="service-city-section__inner page-shell">
      <div class="service-city-section__header">
        <h2 id="city-heading">LVI-urakointi pääkaupunkiseudulla</h2>
        <p>Kaupunkikohtaiset palvelusivut lisätään tähän rakenteeseen myöhemmin.</p>
      </div>
      <div class="service-city-links" aria-label="Tulevat kaupunkikohtaiset LVI-urakointisivut">
        {
          cityPages.map((city) => (
            <span class="service-city-link" data-future-href={city.href}>
              <span>{city.title}</span>
              <span aria-hidden="true">→</span>
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSection
    id="lvi-urakointi-ukk"
    title="Usein kysyttyä LVI-urakoinnista"
    intro="Kysymykset ja vastaukset täydennetään osio kerrallaan."
    items={faqItems}
  />

  <SplitCta
    id="keskustele-urakasta"
    title="Keskustele LVI-urakastasi"
    text="Kerro lyhyesti kohteesta ja projektin vaiheesta. Täydennämme yhteydenoton sisältöä myöhemmin."
    ctaLabel="Pyydä tarjous"
    ctaHref="/yhteystiedot/"
    image="/images/home/contact-shower-cropped.jpg"
    imageAlt="Kultainen sadesuihku viimeistellyssä tummassa märkätilassa"
  />
</BaseLayout>
