---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import content from "../content/cms/yrityksemme.json";

const { seo, hero, valuesSection } = content;
---

<BaseLayout title={seo.title} description={seo.description} headerTheme={hero.image ? "dark" : "light"}>
  <article class="company-page">
    <header class:list={["company-intro", { "company-intro--image": Boolean(hero.image) }]} aria-labelledby="company-page-title">
      {hero.image && (
        <>
          <CmsImage class="company-intro__image" src={hero.image} alt={hero.imageAlt || ""} sizes="100vw" loading="eager" fetchpriority="high" />
          <div class="company-intro__shade" aria-hidden="true"></div>
        </>
      )}
      <div class="company-shell">
        <Breadcrumbs items={[{ label: "Etusivu", href: "/" }, { label: hero.pageTitle }]} />

        <div class="company-intro__layout">
          <div class="company-intro__copy">
            <h1 id="company-page-title">{hero.pageTitle}</h1>
            <p class="company-intro__statement">{hero.statement}</p>
            <p>{hero.intro}</p>
          </div>
        </div>
      </div>
    </header>

    <section class="company-values" aria-labelledby="company-values-title">
      <div class="company-shell">
        <h2 id="company-values-title">{valuesSection.title}</h2>
        <div class="company-values__text">
          {valuesSection.text.trim().split(/\r?\n\s*\r?\n/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="company-owners">
          {valuesSection.owners.map((owner, index) => (
            <article class="company-owner" aria-labelledby={`company-owner-${index}`}>
              <figure class="company-owner__image">
                {owner.image ? <CmsImage src={owner.image} alt={owner.imageAlt || owner.name} sizes="(max-width: 760px) 100vw, (max-width: 1568px) 46vw, 708px" loading="lazy" /> : <div class="company-owner__placeholder" aria-hidden="true"></div>}
              </figure>
              <h3 class="company-owner__name" id={`company-owner-${index}`}>{owner.name}</h3>
              <div class="company-owner__text">
                {owner.text.trim().split(/\r?\n\s*\r?\n/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

  </article>
</BaseLayout>
