---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import NumberedContentList from "../components/NumberedContentList.astro";
import ServiceContentSection from "../components/ServiceContentSection.astro";

const title = "LVI-työt Helsinki ja Uusimaa | LVI-Loisto";
const description =
  "LVI-Loisto toteuttaa LVI-työt uudis- ja saneerauskohteisiin Helsingissä ja Uudellamaalla. Palvelemme taloyhtiöitä, yrityksiä ja kotitalouksia.";

const repairItems = [
  {
    number: "01",
    title: "Vesimittarivaihdot",
    text: "Vesimittareiden vaihdot taloyhtiöihin ja muihin soveltuviin kohteisiin.",
  },
  {
    number: "02",
    title: "Verkostojen tasapainotus ja säätö",
    text: "Lämmitysverkostojen tasapainotukset, pakkaskauden säädöt ja vesivirtojen mittaustyöt.",
  },
  {
    number: "03",
    title: "Käyttövesiverkostot",
    text: "Käyttövesiputkistojen asennukset ja muut LVI-työt osana uudis- ja saneerauskohteita.",
  },
  {
    number: "04",
    title: "Patteriverkostot",
    text: "Patteriverkostojen asennukset ja niihin liittyvät muutostyöt.",
  },
];

const customerGroups = [
  {
    title: "Kotitaloudet",
    text: "LVI-uudisrakentamista, saneerauksia ja korjaustöitä omakotitaloihin, asuntoihin ja muihin yksityisiin kohteisiin.",
  },
  {
    title: "Taloyhtiöt",
    text: "LVI-saneerauksia, korjaustöitä, verkostojen säätöjä, vesimittaritöitä sekä käyttövesi- ja patteriverkostojen asennuksia.",
  },
  {
    title: "Rakennusalan yritykset",
    text: "LVI-töitä uudis- ja saneerauskohteisiin osana rakennusprojektin muuta toteutusta.",
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero lvi-work-hero" aria-labelledby="lvi-work-heading">
    <img
      class="service-page-hero__image"
      src="/images/lvi-tyot/tekninen-tila-hero.webp"
      alt="Siisti tekninen tila, jossa on näkyviä LVI-putkistoja ja lämmönjakolaitteita"
      loading="eager"
      fetchpriority="high"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-työt" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="lvi-work-heading">LVI-työt Helsingissä ja Uudellamaalla</h1>
        <p>LVI-Loisto toteuttaa LVI-uudisrakentamisen, saneeraustyöt ja korjaustyöt taloyhtiöille, rakennusalan yrityksille ja kotitalouksille. Palvelemme joustavasti niin pienissä kuin suuremmissakin LVI-töissä.</p>
        <div class="service-page-hero__actions">
          <a class="service-page-hero__primary" href="/yhteystiedot/">Pyydä tarjous</a>
          <a class="service-page-hero__secondary" href="/yhteystiedot/">Ota yhteyttä</a>
        </div>
      </div>
    </div>
  </section>

  <div class="service-content-page lvi-work-page">
    <ServiceContentSection
      id="monipuoliset-lvi-tyot"
      title="Monipuoliset LVI-työt uudis- ja saneerauskohteisiin"
    >
      <div class="service-prose">
        <p>LVI-Loisto tarjoaa LVI-palveluita uudisrakentamiseen, saneerauksiin ja erilaisiin korjaustöihin Helsingissä ja muualla Uudellamaalla. Palvelemme taloyhtiöitä, rakennusalan yrityksiä ja kotitalouksia kohteen ja työn laajuuden mukaan.</p>
        <p>Toteutamme sekä kokonaisia LVI-töitä uudis- ja saneerauskohteisiin että yksittäisiä asennus- ja korjaustöitä. Työn sisältö suunnitellaan aina kohteen tarpeiden, olemassa olevien järjestelmien ja mahdollisten LVI-suunnitelmien perusteella.</p>
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="uudisrakentaminen" title="LVI-työt uudisrakentamiseen">
      <div class="lvi-work-split">
        <div class="service-prose">
          <p>Toteutamme LVI-töitä uusiin asuinrakennuksiin ja toimimme tarvittaessa osana laajempaa rakennusprojektia. LVI-asennukset sovitetaan rakennuksen suunnitelmiin ja muiden työvaiheiden etenemiseen.</p>
          <p>Uudisrakentamisen LVI-kohteitamme ovat esimerkiksi:</p>
          <ul class="service-simple-list">
            <li>omakotitalot</li>
            <li>rivitalot</li>
            <li>kerrostalot</li>
          </ul>
          <p>Työn laajuus voi vaihdella yksittäisistä asennuksista laajempaan LVI-kokonaisuuteen kohteen ja tilaajan tarpeiden mukaan.</p>
        </div>
        <figure class="lvi-work-split__media">
          <img
            src="/images/lvi-tyot/uudisrakentamisen-putkiasennukset.webp"
            alt="Uudisrakennuksen siististi toteutettuja putkiasennuksia ja jakotukki"
            loading="lazy"
          />
        </figure>
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="saneeraustyot" title="LVI-saneeraustyöt">
      <div class="service-prose">
        <p>LVI-saneerauksessa olemassa olevia järjestelmiä uusitaan, muutetaan tai täydennetään rakennuksen tarpeiden mukaan. Toteutamme saneeraustöitä niin yksittäisiin asuntoihin kuin laajempiin asuin- ja kiinteistökohteisiin.</p>
        <p>Teemme LVI-saneerauksia:</p>
        <ul class="service-simple-list">
          <li>omakotitaloissa</li>
          <li>rivitaloissa</li>
          <li>kerrostaloissa</li>
        </ul>
        <p>Saneerauskohteissa huomioimme rakennuksen nykyiset järjestelmät ja rakenteet sekä sen, miten uudet asennukset voidaan toteuttaa osana muuta remonttia.</p>
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="korjaukset-ja-asennukset" title="LVI-korjaukset ja asennustyöt">
      <div class="service-prose lvi-work-list-intro">
        <p>Laajempien uudis- ja saneeraustöiden lisäksi toteutamme LVI-korjauksia ja asennuksia esimerkiksi pientaloihin ja taloyhtiöihin.</p>
        <p>Palveluihimme kuuluvat muun muassa:</p>
      </div>
      <ol class="lvi-work-numbered-list" aria-label="LVI-korjaukset ja asennustyöt">
        {repairItems.map((item) => (
          <li>
            <span>{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </ServiceContentSection>

    <ServiceContentSection
      id="kohteet"
      title="LVI-työt erilaisiin kohteisiin"
      intro="Palvelemme yksityisasiakkaita, taloyhtiöitä ja rakennusalan yrityksiä. Työn laajuus määritellään aina kohteen ja tarpeen mukaan."
    >
      <NumberedContentList items={customerGroups} columns={3} ariaLabel="LVI-töiden asiakasryhmät" />
    </ServiceContentSection>

    <ServiceContentSection id="pienet-ja-suuret-tyot" title="Pienet ja suuret LVI-työt">
      <div class="service-prose">
        <p>LVI-Loisto ottaa vastaan sekä pienempiä LVI-töitä että suurempia uudis- ja saneerauskokonaisuuksia. Työn sisältö ja toteutustapa sovitaan aina kohteen tarpeiden perusteella.</p>
        <p>Jos kyseessä on laajempi LVI-urakka, tutustu myös urakointipalveluumme.</p>
        <a class="text-link" href="/lvi-urakointi/">Tutustu LVI-urakointiin <span aria-hidden="true">→</span></a>
      </div>
    </ServiceContentSection>

    <ServiceContentSection id="toimialue" title="LVI-työt Helsingissä ja Uudellamaalla">
      <div class="service-prose">
        <p>LVI-Loisto palvelee asiakkaita Helsingissä ja muualla Uudenmaan alueella. Toimipisteemme sijaitsee Vantaalla, ja toteutamme LVI-töitä eri puolilla pääkaupunkiseutua sekä soveltuvissa kohteissa muualla Uudellamaalla.</p>
        <p>Kun tarvitset tekijän uudisrakentamisen LVI-töihin, saneeraukseen tai yksittäiseen LVI-korjaukseen, ota yhteyttä ja kerro kohteesta sekä työn tarpeesta.</p>
      </div>
    </ServiceContentSection>
  </div>

  <section class="lvi-work-final-cta" aria-labelledby="lvi-work-cta-heading">
    <div class="lvi-work-final-cta__inner page-shell">
      <div>
        <h2 id="lvi-work-cta-heading">Tarvitsetko tekijän LVI-töihin?</h2>
        <p>Kerro meille kohteesta ja tarvitsemastasi LVI-työstä. Voit olla yhteydessä puhelimitse, sähköpostilla tai lähettää tarjouspyynnön yhteydenottolomakkeella.</p>
      </div>
      <div class="lvi-work-final-cta__actions">
        <a class="lvi-work-final-cta__primary" href="/yhteystiedot/">Pyydä tarjous</a>
        <a class="lvi-work-final-cta__secondary" href="/yhteystiedot/">Yhteystiedot <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
