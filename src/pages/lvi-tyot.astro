---
import BaseLayout from "../layouts/BaseLayout.astro";
import CmsImage from "../components/CmsImage.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactPopover from "../components/ContactPopover.astro";
import { micromark } from "micromark";
import ServiceAccordion from "../components/ServiceAccordion.astro";
import ServiceReference from "../components/ServiceReference.astro";
import content from "../content/cms/lvi-tyot.json";

const title = content.seo.title;
const description = content.seo.description;
const sections = content.sections.map((section, index) => ({
  ...section,
  id: section.id || `lvi-osio-${index + 1}`,
  body: section.body ?? [],
  subsections: (section.subsections ?? []).map((subsection) => ({ ...subsection, body: subsection.body ?? [] })),
}));
const sectionNavigation = sections.map((section) => ({ label: section.title, href: `#${section.id}` }));
const accordionIds = new Set(["korjaukset-ja-asennukset", "lammitys", "ilmanvaihto", "erikoisosaaminen"]);
---

<BaseLayout title={title} description={description} headerTheme="dark" pageClass="service-detail-page">
  <section class="service-page-hero lvi-work-hero" aria-labelledby="lvi-work-heading">
    <CmsImage
      sizes="100vw"
      class="service-page-hero__image"
      src={content.hero.image}
      alt={content.hero.imageAlt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-työt" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="lvi-work-heading">{content.hero.title}</h1>
        <p>{content.hero.intro}</p>
        <div class="service-page-hero__actions">
          <div class="service-page-hero__contact" data-lvi-work-contact>
            <button
              class="service-page-hero__primary"
              type="button"
              aria-controls="lvi-work-hero-contact-popover"
              aria-expanded="false"
              data-lvi-work-contact-trigger
            >{content.hero.primaryCta}</button>
            <ContactPopover
              id="lvi-work-hero-contact-popover"
              className="service-page-contact-popover"
            />
          </div>
          <a class="service-page-hero__secondary" href="#palvelut">{content.hero.secondaryCta}</a>
        </div>
        {sectionNavigation.length > 0 && (
          <details class="lvi-work-hero__toc" data-lvi-work-toc>
            <summary>Sisällysluettelo <span aria-hidden="true">▾</span></summary>
            <div class="process-contact-popover lvi-work-hero__toc-panel">
              <nav class="lvi-work-hero__toc-list" aria-label="LVI-töiden sisältö">
                <ul>
                  {sectionNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
              </nav>
            </div>
          </details>
        )}
      </div>
    </div>
  </section>

  <div class="lvi-work-content lvi-work-content--structured">
    <div class="lvi-work-content__layout">
      <article class="lvi-work-article">
        {sections.map((section, index) => (
          <>
          <section class="lvi-work-article__section" id={section.id} aria-labelledby={`${section.id}-heading`}>
              <div class="lvi-work-article__copy">
                <h2 id={`${section.id}-heading`}>{section.title}</h2>
                {section.body.map((paragraph) => <Fragment set:html={micromark(paragraph)} />)}
              </div>
            {section.image && (
              <figure class="lvi-work-photo">
                <div class:list={["lvi-work-photo__frames", { "lvi-work-photo__frames--pair": Boolean("supportingImage" in section && section.supportingImage) }]}>
                  <CmsImage src={section.image} alt={section.imageAlt || ""} sizes={"supportingImage" in section && section.supportingImage ? "(max-width: 760px) 100vw, 720px" : "(max-width: 1568px) 100vw, 1440px"} loading="lazy" />
                  {"supportingImage" in section && section.supportingImage && <CmsImage src={section.supportingImage} alt={section.supportingImageAlt || ""} sizes="(max-width: 760px) 100vw, 720px" loading="lazy" />}
                </div>
                {"imageCaption" in section && section.imageCaption && <figcaption>{section.imageCaption}</figcaption>}
              </figure>
            )}
            {accordionIds.has(section.id) ? <ServiceAccordion items={section.subsections} /> : section.id === "kohteet" ? (
              <div class="lvi-work-audience-links">
                {section.subsections.map((subsection) => (
                  <article>
                    <h3>{subsection.title}</h3>
                    <p>{"summary" in subsection ? subsection.summary : subsection.body[0]}</p>
                    {"href" in subsection && <a class="text-link" href={subsection.href}>{"linkLabel" in subsection ? subsection.linkLabel : "Tutustu palveluihin"}</a>}
                  </article>
                ))}
              </div>
            ) : section.subsections.length > 0 && (
              <div class="service-detail-grid lvi-work-subsections">
                {section.subsections.map((subsection) => (
                  <article>
                    <h3>{subsection.title}</h3>
                    {subsection.body.map((paragraph) => <Fragment set:html={micromark(paragraph)} />)}
                  </article>
                ))}
              </div>
            )}
          </section>
          {index === 0 && (
            <section class="lvi-work-service-nav" id="palvelut" aria-labelledby="service-nav-heading">
              <h2 id="service-nav-heading">{content.serviceNavigation.title}</h2>
              <nav class="lvi-work-service-nav__links" aria-label={content.serviceNavigation.title}>
                {content.serviceNavigation.items.map((item) => (
                  <a href={item.href}><span>{item.title}</span><p>{item.text}</p></a>
                ))}
              </nav>
            </section>
          )}
          {content.references.filter((reference) => reference.afterSection === section.id).map((reference) => <ServiceReference reference={reference} />)}
          </>
        ))}
      </article>
    </div>
  </div>

  <script>
    const initLviWorkInteractions = () => {
      const contacts = Array.from(document.querySelectorAll("[data-lvi-work-contact]"));
      const toc = document.querySelector("[data-lvi-work-toc]");

      const setOpen = (contact: Element, isOpen: boolean, returnFocus = false) => {
        const trigger = contact.querySelector("[data-lvi-work-contact-trigger]");
        const popover = contact.querySelector("[data-lvi-work-contact-popover]");

        if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

        popover.hidden = !isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (returnFocus) trigger.focus();
      };

      contacts.forEach((contact) => {
        const trigger = contact.querySelector("[data-lvi-work-contact-trigger]");
        const popover = contact.querySelector("[data-lvi-work-contact-popover]");
        const closeButton = contact.querySelector("[data-lvi-work-contact-close]");

        if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

        trigger.addEventListener("click", () => {
          const shouldOpen = popover.hidden;
          contacts.forEach((item) => setOpen(item, false));
          if (toc instanceof HTMLDetailsElement) toc.open = false;
          setOpen(contact, shouldOpen);
        });

        closeButton?.addEventListener("click", () => setOpen(contact, false, true));
        popover.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(contact, false));
        });
      });

      if (toc instanceof HTMLDetailsElement) {
        toc.addEventListener("toggle", () => {
          if (toc.open) {
            contacts.forEach((contact) => setOpen(contact, false));
            toc.scrollIntoView({ block: "start" });
          }
        });
        toc.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => { toc.open = false; });
        });
      }

      document.addEventListener("pointerdown", (event) => {
        if (toc instanceof HTMLDetailsElement && toc.open && !toc.contains(event.target as Node)) {
          toc.open = false;
        }
        contacts.forEach((contact) => {
          const popover = contact.querySelector("[data-lvi-work-contact-popover]");
          if (popover instanceof HTMLElement && !popover.hidden && !contact.contains(event.target as Node)) {
            setOpen(contact, false);
          }
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        if (toc instanceof HTMLDetailsElement && toc.open) {
          toc.open = false;
          toc.querySelector("summary")?.focus();
        }
        contacts.forEach((contact) => {
          const popover = contact.querySelector("[data-lvi-work-contact-popover]");
          if (popover instanceof HTMLElement && !popover.hidden) setOpen(contact, false, true);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLviWorkInteractions, { once: true });
    } else {
      initLviWorkInteractions();
    }
  </script>
</BaseLayout>
