---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactPopover from "../components/ContactPopover.astro";
import content from "../content/cms/lvi-tyot.json";

const title = content.seo.title;
const description = content.seo.description;
const repairItems = content.repairs.items;
const customerGroups = content.audiences.items;
const sectionNavigation = [
  { label: content.hero.navigation.intro, href: "#monipuoliset-lvi-tyot" },
  { label: content.hero.navigation.newBuild, href: "#uudisrakentaminen" },
  { label: content.hero.navigation.renovation, href: "#saneeraustyot" },
  { label: content.hero.navigation.repairs, href: "#korjaukset-ja-asennukset" },
  { label: content.hero.navigation.audiences, href: "#kohteet" },
  { label: content.hero.navigation.region, href: "#toimialue" },
];
---

<BaseLayout title={title} description={description}>
  <section class="service-page-hero lvi-work-hero" aria-labelledby="lvi-work-heading">
    <img
      class="service-page-hero__image"
      src={content.hero.image}
      alt={content.hero.imageAlt}
      loading="eager"
      fetchpriority="high"
    />
    <div class="service-page-hero__shade" aria-hidden="true"></div>
    <div class="service-page-hero__inner page-shell">
      <Breadcrumbs
        variant="dark"
        items={[{ label: "Etusivu", href: "/" }, { label: "LVI-työt" }]}
      />
      <div class="service-page-hero__copy">
        <h1 id="lvi-work-heading">{content.hero.title}</h1>
        <p>{content.hero.intro}</p>
        <div class="service-page-hero__actions">
          <div class="service-page-hero__contact" data-lvi-work-contact>
            <button
              class="service-page-hero__primary"
              type="button"
              aria-controls="lvi-work-hero-contact-popover"
              aria-expanded="false"
              data-lvi-work-contact-trigger
            >{content.hero.primaryCta}</button>
            <ContactPopover
              id="lvi-work-hero-contact-popover"
              className="service-page-contact-popover"
            />
          </div>
          <a class="service-page-hero__secondary" href="/yhteystiedot/">{content.hero.secondaryCta}</a>
        </div>
        <nav class="section-anchor-nav section-anchor-nav--hero lvi-work-hero__nav" aria-label="LVI-töiden sisältö">
          {sectionNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </div>
  </section>

  <div class="lvi-work-content">
    <div class="lvi-work-content__layout">
      <article class="lvi-work-article">
        <section class="lvi-work-article__section" id="monipuoliset-lvi-tyot" aria-labelledby="monipuoliset-lvi-tyot-heading">
          <h2 id="monipuoliset-lvi-tyot-heading">{content.introSection.title}</h2>
          {content.introSection.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="lvi-work-article__section" id="uudisrakentaminen" aria-labelledby="uudisrakentaminen-heading">
          <h2 id="uudisrakentaminen-heading">{content.newBuild.title}</h2>
          {content.newBuild.bodyBeforeList.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="lvi-work-bullet-list">
            {content.newBuild.items.map((item) => <li>{item}</li>)}
          </ul>
          <p>{content.newBuild.bodyAfterList}</p>
          <figure class="lvi-work-article__media">
            <img
              src={content.newBuild.image}
              alt={content.newBuild.imageAlt}
              loading="lazy"
            />
          </figure>
        </section>

        <section class="lvi-work-article__section" id="saneeraustyot" aria-labelledby="saneeraustyot-heading">
          <h2 id="saneeraustyot-heading">{content.renovation.title}</h2>
          {content.renovation.body.map((paragraph) => <p>{paragraph}</p>)}
          <p class="lvi-work-list-heading">{content.renovation.listHeading}</p>
          <ul class="lvi-work-bullet-list">
            {content.renovation.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="lvi-work-article__section" id="korjaukset-ja-asennukset" aria-labelledby="korjaukset-ja-asennukset-heading">
          <h2 id="korjaukset-ja-asennukset-heading">{content.repairs.title}</h2>
          {content.repairs.body.map((paragraph) => <p>{paragraph}</p>)}
          <ol class="lvi-work-service-list" aria-label="LVI-korjaukset ja asennustyöt">
            {repairItems.map((item) => (
              <li>
                <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="lvi-work-article__section" id="kohteet" aria-labelledby="kohteet-heading">
          <h2 id="kohteet-heading">{content.audiences.title}</h2>
          <p>{content.audiences.intro}</p>
          <div class="lvi-work-audience-list">
            {customerGroups.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="lvi-work-article__section" id="pienet-ja-suuret-tyot" aria-labelledby="pienet-ja-suuret-tyot-heading">
          <h2 id="pienet-ja-suuret-tyot-heading">{content.scale.title}</h2>
          {content.scale.body.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href="/lvi-urakointi/">{content.scale.linkLabel} <span aria-hidden="true">→</span></a>
        </section>

        <section class="lvi-work-article__section" id="toimialue" aria-labelledby="toimialue-heading">
          <h2 id="toimialue-heading">{content.region.title}</h2>
          {content.region.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      </article>
    </div>
  </div>

  <section class="lvi-work-final-cta" aria-labelledby="lvi-work-cta-heading">
    <div class="lvi-work-final-cta__inner page-shell">
      <div>
        <h2 id="lvi-work-cta-heading">{content.finalCta.title}</h2>
        <p>{content.finalCta.text}</p>
      </div>
      <div class="lvi-work-final-cta__actions">
        <div class="lvi-work-final-cta__contact" data-lvi-work-contact>
          <button
            class="lvi-work-final-cta__primary"
            type="button"
            aria-controls="lvi-work-final-contact-popover"
            aria-expanded="false"
            data-lvi-work-contact-trigger
          >{content.finalCta.primaryCta}</button>
          <ContactPopover
            id="lvi-work-final-contact-popover"
            className="lvi-work-final-cta__popover"
          />
        </div>
        <a class="lvi-work-final-cta__secondary" href="/yhteystiedot/">{content.finalCta.secondaryCta} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <script>
    const initLviWorkContactPopovers = () => {
      const contacts = Array.from(document.querySelectorAll("[data-lvi-work-contact]"));

      const setOpen = (contact: Element, isOpen: boolean, returnFocus = false) => {
        const trigger = contact.querySelector("[data-lvi-work-contact-trigger]");
        const popover = contact.querySelector("[data-lvi-work-contact-popover]");

        if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

        popover.hidden = !isOpen;
        trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        if (returnFocus) trigger.focus();
      };

      contacts.forEach((contact) => {
        const trigger = contact.querySelector("[data-lvi-work-contact-trigger]");
        const popover = contact.querySelector("[data-lvi-work-contact-popover]");
        const closeButton = contact.querySelector("[data-lvi-work-contact-close]");

        if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) return;

        trigger.addEventListener("click", () => {
          const shouldOpen = popover.hidden;
          contacts.forEach((item) => setOpen(item, false));
          setOpen(contact, shouldOpen);
        });

        closeButton?.addEventListener("click", () => setOpen(contact, false, true));
        popover.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(contact, false));
        });
      });

      document.addEventListener("pointerdown", (event) => {
        contacts.forEach((contact) => {
          const popover = contact.querySelector("[data-lvi-work-contact-popover]");
          if (popover instanceof HTMLElement && !popover.hidden && !contact.contains(event.target as Node)) {
            setOpen(contact, false);
          }
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        contacts.forEach((contact) => {
          const popover = contact.querySelector("[data-lvi-work-contact-popover]");
          if (popover instanceof HTMLElement && !popover.hidden) setOpen(contact, false, true);
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initLviWorkContactPopovers, { once: true });
    } else {
      initLviWorkContactPopovers();
    }
  </script>
</BaseLayout>
